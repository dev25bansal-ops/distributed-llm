        client = TestClient(request_id_test_app)
        resp = client.get("/echo-state")
        val = resp.headers["X-Request-ID"]
        # uuid hex with dashes: 8-4-4-4-12
        assert re.match(
            r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            val,
            re.I,
        )

