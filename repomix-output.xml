def _png_b64(size=(64, 64), color="red"):
    from PIL import Image
    import io
    img = Image.new("RGB", size, color=color)
    buf = io.BytesIO()
    img.save(buf, format="PNG")
    return base64.b64encode(buf.getvalue()).decode()


