      </button>
    </div>

    {#if reachable === true}
      <div class="status-msg ok">Connected to Ollama at {config.host}:{config.port}</div>
    {:else if reachable === false}
      <div class="status-msg err">Cannot reach Ollama at {config.host}:{config.port}</div>
    {/if}

    {#if models.length > 0}
