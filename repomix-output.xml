// ── Release Data ───────────────────────────────────────────────────────

const RELEASES = [
    {
        version: 'v0.4.0',
        date: '2026-05-16',
        codename: 'Production Readiness',
        breaking: false,
        highlights: [
            'Graceful shutdown with request draining',
