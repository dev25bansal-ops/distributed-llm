<script>
const API_URL = '{{ api_url }}';
let ws = null;
let refreshMs = 2000;
let throughputHistory = [];
const MAX_HISTORY = 60;

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function updateInterval() {
    refreshMs = parseInt(document.getElementById('refresh-interval').value);
}

// WebSocket connection
function connectWS() {
    const wsUrl = API_URL.replace('http', 'ws') + '/ws/metrics?interval=' + (refreshMs / 1000);
    ws = new WebSocket(wsUrl);

    ws.onopen = () => {
        document.getElementById('connection-status').textContent = 'Connected';
        document.getElementById('connection-status').className = 'status connected';
    };

    ws.onmessage = (event) => {
        try {
            const data = JSON.parse(event.data);
            updateDashboard(data);
        } catch (e) {}
    };

    ws.onclose = () => {
        document.getElementById('connection-status').textContent = 'Disconnected';
        document.getElementById('connection-status').className = 'status disconnected';
        setTimeout(connectWS, 3000);
    };

    ws.onerror = () => ws.close();
}

function updateDashboard(data) {
    // Key metrics
    const coord = data.coordinator || {};
    const sched = data.scheduler || {};
    const latency = data.latency || {};

    updateMetric('rps', sched.active_requests || 0, '');
    updateMetric('avg-latency', latency.avg_ms ? latency.avg_ms.toFixed(0) + 'ms' : '—', '');
    updateMetric('tps', latency.throughput_tok_s ? latency.throughput_tok_s.toFixed(1) : '—', '');
    updateMetric('cache-hit', data.kv_cache?.hit_rate ? (data.kv_cache.hit_rate * 100).toFixed(1) + '%' : '—', '');
    updateMetric('queue-depth', sched.pending_requests || 0, '');
    updateMetric('cost-per-token', coord.cost_per_token ? '$' + coord.cost_per_token.toFixed(4) : '—', '');

    // Queue visualization
    const pending = sched.pending_requests || 0;
    const active = sched.active_requests || 0;
    const capacity = sched.max_batch_size || 1000;
    const fillPct = Math.min(100, ((pending + active) / capacity) * 100);
    document.getElementById('queue-fill').style.width = fillPct + '%';
    document.getElementById('q-pending').textContent = pending;
    document.getElementById('q-active').textContent = active;
    document.getElementById('q-capacity').textContent = capacity;

    // Throughput history
    const tps = latency.throughput_tok_s || 0;
    throughputHistory.push(tps);
    if (throughputHistory.length > MAX_HISTORY) throughputHistory.shift();
    drawThroughputChart();

    // GPU cards
    updateGPUCards(data.gpu);

    // Cache stats
    updateCacheStats(data.kv_cache);

    // Cost stats
    updateCostStats(coord);

    // Node topology
    updateNodeTopology(data.nodes);

    // Health
    updateHealth(data);
}

function updateMetric(id, value, trend) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
}

function drawThroughputChart() {
    const canvas = document.getElementById('throughput-chart');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width = canvas.parentElement.clientWidth - 32;
    const h = canvas.height = 200;

    ctx.clearRect(0, 0, w, h);

    if (throughputHistory.length < 2) return;

    const max = Math.max(...throughputHistory, 1);
    const step = w / (MAX_HISTORY - 1);

    ctx.beginPath();
    ctx.strokeStyle = '#10a37f';
    ctx.lineWidth = 2;

    throughputHistory.forEach((val, i) => {
        const x = i * step;
        const y = h - (val / max) * (h - 20) - 10;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // Fill
    ctx.lineTo((throughputHistory.length - 1) * step, h);
    ctx.lineTo(0, h);
    ctx.closePath();
    ctx.fillStyle = 'rgba(16, 163, 127, 0.1)';
    ctx.fill();
}

function updateGPUCards(gpu) {
    const container = document.getElementById('gpu-cards');
    if (!gpu || !gpu.utilization) {
        container.innerHTML = '<div class="gpu-card"><div class="name">No GPU data</div></div>';
        return;
    }

    let html = '';
    const utils = gpu.utilization || [];
    const mems = gpu.memory_used || [];
    const totals = gpu.memory_total || [];
    const names = gpu.name || [];

    for (let i = 0; i < Math.max(utils.length, 1); i++) {
        const util = utils[i] || 0;
        const memUsed = mems[i] || 0;
        const memTotal = totals[i] || 1;
        const name = names[i] || `GPU ${i}`;
        const memPct = (memUsed / memTotal * 100);
        const utilClass = util > 80 ? 'high' : util > 50 ? 'medium' : 'low';
        const memClass = memPct > 80 ? 'high' : memPct > 50 ? 'medium' : 'low';

        html += `<div class="gpu-card">
            <div class="name">${escapeHtml(name)}</div>
            <div>Utilization</div>
            <div class="gpu-bar"><div class="gpu-bar-fill ${utilClass}" style="width:${util}%"></div></div>
            <div class="gpu-stats">${util.toFixed(1)}%</div>
            <div style="margin-top:8px">Memory</div>
            <div class="gpu-bar"><div class="gpu-bar-fill ${memClass}" style="width:${memPct}%"></div></div>
            <div class="gpu-stats">${(memUsed/1e9).toFixed(1)}/${(memTotal/1e9).toFixed(1)} GB</div>
        </div>`;
    }
    container.innerHTML = html;
}

function updateCacheStats(kv) {
    const el = document.getElementById('cache-stats');
    if (!kv) { el.innerHTML = '<div class="stat-row"><span class="stat-label">No data</span></div>'; return; }
    el.innerHTML = `
        <div class="stat-row"><span class="stat-label">Hit Rate</span><span class="stat-value">${((kv.hit_rate||0)*100).toFixed(1)}%</span></div>
        <div class="stat-row"><span class="stat-label">Entries</span><span class="stat-value">${kv.entries || 0}</span></div>
        <div class="stat-row"><span class="stat-label">Memory</span><span class="stat-value">${kv.memory_mb ? kv.memory_mb.toFixed(1) + ' MB' : '—'}</span></div>
        <div class="stat-row"><span class="stat-label">Evictions</span><span class="stat-value">${kv.evictions || 0}</span></div>
    `;
}

function updateCostStats(coord) {
    const el = document.getElementById('cost-stats');
    if (!coord) { el.innerHTML = '<div class="stat-row"><span class="stat-label">No data</span></div>'; return; }
    el.innerHTML = `
        <div class="stat-row"><span class="stat-label">Total Cost</span><span class="stat-value">$${(coord.total_cost||0).toFixed(4)}</span></div>
        <div class="stat-row"><span class="stat-label">Cost/1K Tokens</span><span class="stat-value">$${(coord.cost_per_1k_tokens||0).toFixed(4)}</span></div>
        <div class="stat-row"><span class="stat-label">Savings vs Cloud</span><span class="stat-value">${coord.savings_pct ? coord.savings_pct.toFixed(1)+'%' : '—'}</span></div>
        <div class="stat-row"><span class="stat-label">Requests</span><span class="stat-value">${coord.total_requests || 0}</span></div>
    `;
}

function updateNodeTopology(nodes) {
    const el = document.getElementById('node-topology');
    if (!nodes || !nodes.length) { el.innerHTML = '<div class="node-card"><div class="node-name">No nodes</div></div>'; return; }
    let html = '';
    nodes.forEach(n => {
        const healthy = n.healthy !== false;
        html += `<div class="node-card ${healthy ? '' : 'unhealthy'}">
            <div class="node-name">${escapeHtml(n.node_id || n.host || 'Unknown')}</div>
            <div class="node-info">Layers ${n.start_layer||0}-${n.end_layer||0}</div>
            <div class="node-info">${escapeHtml(n.gpu_name || '')}</div>
            <div class="node-info">${healthy ? '✅ Healthy' : '❌ Unhealthy'}</div>
        </div>`;
    });
    el.innerHTML = html;
}

function updateHealth(data) {
    const el = document.getElementById('health-panel');
    const items = [];
    const coord = data.coordinator || {};

    items.push({ label: 'Coordinator', ok: !!data.coordinator });
    items.push({ label: 'Scheduler', ok: !!data.scheduler });
    items.push({ label: 'GPU', ok: !!(data.gpu && data.gpu.utilization) });
    items.push({ label: 'Cache', ok: (data.kv_cache?.hit_rate || 0) > 0 });

    let html = '';
    items.forEach(item => {
        const color = item.ok ? 'green' : 'red';
        html += `<div class="health-item">
            <div class="health-dot ${color}"></div>
            <span>${item.label}</span>
            <span style="margin-left:auto;font-size:12px;color:#666">${item.ok ? 'OK' : 'Degraded'}</span>
        </div>`;
    });
    el.innerHTML = html;
}

// Fallback: poll via HTTP if WebSocket fails
async function pollMetrics() {
    try {
        const res = await fetch(API_URL + '/api/metrics/collector');
        const data = await res.json();
        updateDashboard(data);
    } catch (e) {}
}

// Start
connectWS();
setInterval(pollMetrics, refreshMs * 2); // Fallback polling
</script>
{% endblock %}
