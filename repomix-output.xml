        record = PriceRecord(
            provider=CloudProvider.AWS,
            instance_type="g5.xlarge",
            region="us-east-1",
            price=0.50,
            on_demand_price=1.00,
            timestamp=time.time() - 600,  # 10 minutes ago
            ttl_seconds=300,
