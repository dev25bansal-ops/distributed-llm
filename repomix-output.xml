) -> None:
    """CLI entry point for accuracy verification.

    Runs verification and prints a formatted report to stdout.
    """
    if not prompts:
        prompts = [
            "The capital of France is",
            "In the beginning",
            "The meaning of life is",
            "Write a haiku about",
        ]

    report = verify_accuracy(
        model_name=model_name,
