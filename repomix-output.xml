    <script type="module">
        // Load playground state from URL
        function loadPlaygroundState() {
            const params = new URLSearchParams(window.location.search);
            if (params.has('endpoint')) document.getElementById('playgroundEndpoint').value = params.get('endpoint');
            if (params.has('model')) document.getElementById('playgroundModel').value = params.get('model');
            if (params.has('temp')) {
                document.getElementById('playgroundTemp').value = params.get('temp');
                document.getElementById('playgroundTempValue').textContent = params.get('temp');
            }
            if (params.has('max_tokens')) document.getElementById('playgroundMaxTokens').value = params.get('max_tokens');
            if (params.has('messages')) document.getElementById('playgroundMessages').value = params.get('messages');
        }

        // Save playground state to URL
        function savePlaygroundState() {
            const params = new URLSearchParams();
            params.set('endpoint', document.getElementById('playgroundEndpoint').value);
            params.set('model', document.getElementById('playgroundModel').value);
            params.set('temp', document.getElementById('playgroundTemp').value);
            params.set('max_tokens', document.getElementById('playgroundMaxTokens').value);
            params.set('messages', document.getElementById('playgroundMessages').value);
            window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
        }

        // Initialize
        loadPlaygroundState();

        // Temperature slider
        document.getElementById('playgroundTemp')?.addEventListener('input', (e) => {
            document.getElementById('playgroundTempValue').textContent = e.target.value;
        });

        // Share button
        document.getElementById('playgroundShare')?.addEventListener('click', () => {
            savePlaygroundState();
            navigator.clipboard.writeText(window.location.href).then(() => {
                alert('Link copied to clipboard!');
            });
        });

        // Send button
        document.getElementById('playgroundSend')?.addEventListener('click', async () => {
            const endpoint = document.getElementById('playgroundEndpoint').value;
            const model = document.getElementById('playgroundModel').value;
            const temp = parseFloat(document.getElementById('playgroundTemp').value);
            const maxTokens = parseInt(document.getElementById('playgroundMaxTokens').value);
            const messages = document.getElementById('playgroundMessages').value;
            const output = document.getElementById('playgroundOutput');
            const status = document.getElementById('playgroundStatus');

            output.textContent = 'Sending request...';
            status.textContent = '';
            status.className = 'playground-status';

            try {
                const body = {
                    model,
                    messages: JSON.parse(messages),
                    temperature: temp,
                    max_tokens: maxTokens,
                };

                const response = await fetch(`http://localhost:8000${endpoint}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body),
                });

                const data = await response.json();
                output.textContent = JSON.stringify(data, null, 2);
                status.textContent = `${response.status} ${response.statusText}`;
                status.className = `playground-status ${response.ok ? 'success' : 'error'}`;

                savePlaygroundState();
            } catch (e) {
                output.textContent = `Error: ${e.message}\n\nMake sure DistLLM is running on localhost:8000`;
                status.textContent = 'Error';
                status.className = 'playground-status error';
            }
        });

        // API endpoint navigation
        document.querySelectorAll('.api-endpoint').forEach(link => {
            link.addEventListener('click', (e) => {
                document.querySelectorAll('.api-endpoint').forEach(l => l.classList.remove('active'));
                link.classList.add('active');
            });
        });

        // Copy buttons
        document.querySelectorAll('.copy-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                navigator.clipboard.writeText(btn.dataset.copy).then(() => {
                    btn.textContent = 'Copied!';
                    setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
                });
            });
        });
    </script>
</body>
</html>
