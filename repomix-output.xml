#
# Optimizations applied: SDPA (FlashAttention via PyTorch), FP16 precision,
# TF32 matmul, cuDNN autotune, CUDA warmup.

BENCHMARK_TARGETS: Dict[str, Dict[str, Any]] = {
    "throughput-small": {
