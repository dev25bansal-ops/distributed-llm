.showcase-info p { font-size: 13px; color: var(--dim); line-height: 1.5; margin-bottom: 8px; }
.showcase-meta { display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--dim); }
.showcase-author { color: var(--green); }
.showcase-submit { text-align: center; padding: 32px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
.showcase-submit p { font-size: 14px; color: var(--dim); margin-bottom: 12px; }
.contributors-grid { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-bottom: 24px; }
.contributor-card { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; transition: all 0.2s; width: 90px; }
.contributor-card:hover { border-color: var(--green); transform: translateY(-2px); }
.contributor-card img { width: 48px; height: 48px; border-radius: 50%; }
.contributor-name { font-size: 11px; font-weight: 600; color: var(--text); text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 70px; }
.contributor-commits { font-size: 10px; color: var(--dim); }
.contributors-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.newsletter-signup { display: flex; justify-content: space-between; align-items: center; gap: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 24px; margin-bottom: 32px; }
.newsletter-info h3 { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
.newsletter-info p { font-size: 13px; color: var(--dim); }
.newsletter-form { display: flex; gap: 8px; }
.newsletter-form input { padding: 10px 14px; border: 1px solid var(--border); border-radius: 6px; background: var(--card); color: var(--text); font-size: 14px; min-width: 250px; }
.newsletter-archive { }
.newsletter-archive h3 { font-size: 16px; font-weight: 700; margin-bottom: 16px; }
.newsletter-item { display: flex; gap: 16px; padding: 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px; }
.newsletter-date { font-family: var(--font-mono); font-size: 12px; color: var(--green); min-width: 80px; flex-shrink: 0; }
.newsletter-content h4 { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
.newsletter-content p { font-size: 13px; color: var(--dim); }
.events-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
.event-card { display: flex; gap: 16px; padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
.event-date { text-align: center; flex-shrink: 0; }
.event-month { display: block; font-size: 12px; font-weight: 600; color: var(--green); text-transform: uppercase; }
.event-day { display: block; font-size: 24px; font-weight: 800; font-family: var(--font-mono); color: var(--text); }
.event-info h4 { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
.event-info p { font-size: 13px; color: var(--dim); line-height: 1.5; margin-bottom: 8px; }
.event-time { font-size: 12px; color: var(--green); }

/* ─── Cookie Consent Banner ─── */
.cookie-consent {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: var(--card);
    border-top: 1px solid var(--border);
    padding: 16px 24px;
    opacity: 0;
    transform: translateY(100%);
    transition: all 0.3s ease;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.3);
}
.cookie-consent-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}
.cookie-consent-text p {
    font-size: 13px;
    color: var(--dim);
    margin: 0;
    line-height: 1.5;
}
.cookie-consent-text strong {
    color: var(--text);
}
.cookie-consent-text a {
    color: var(--green);
    text-decoration: underline;
}
.cookie-consent-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
}
.cookie-consent-accept {
    padding: 8px 16px;
    background: var(--green);
    color: #000;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}
.cookie-consent-accept:hover {
    opacity: 0.9;
}
.cookie-consent-learn-more {
    padding: 8px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    transition: all 0.2s;
}
.cookie-consent-learn-more:hover {
    border-color: var(--green);
}

/* ─── Legal Pages ─── */
.legal-page {
    max-width: 800px;
    margin: 0 auto;
}
.legal-page h1 {
    font-size: 32px;
    font-weight: 800;
    margin-bottom: 8px;
}
.legal-updated {
    font-size: 14px;
    color: var(--dim);
    margin-bottom: 48px;
}
.legal-section {
    margin-bottom: 48px;
}
.legal-section h2 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
}
.legal-section h3 {
    font-size: 16px;
    font-weight: 700;
    margin-top: 24px;
    margin-bottom: 12px;
}
.legal-section p {
    font-size: 14px;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 12px;
}
.legal-section ul {
    padding-left: 24px;
    margin-bottom: 12px;
}
.legal-section li {
    font-size: 14px;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 8px;
}
.legal-section a {
    color: var(--green);
    text-decoration: underline;
}

/* ─── i18n Language Switcher ─── */
.lang-switcher {
    position: relative;
}
.lang-switcher-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
}
.lang-switcher-btn:hover {
    border-color: var(--green);
}
.lang-flag {
    font-size: 14px;
}
.lang-name {
    font-weight: 600;
}
.lang-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 4px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 4px;
    min-width: 180px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    z-index: 1000;
}
.lang-option {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 12px;
    background: none;
    border: none;
    border-radius: 4px;
    font-size: 13px;
    color: var(--text);
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
}
.lang-option:hover {
    background: var(--surface);
}
.lang-option.active {
    background: rgba(0,230,118,0.1);
    color: var(--green);
}
.lang-flag {
    font-size: 16px;
}
.lang-native {
    font-weight: 600;
}
.lang-english {
    font-size: 11px;
    color: var(--dim);
    margin-left: auto;
}

@media (max-width: 768px) {
    .cookie-consent-inner {
        flex-direction: column;
        text-align: center;
    }
    .cookie-consent-actions {
        width: 100%;
        justify-content: center;
    }
}
/* ─── A9: Model Playground ─── */
