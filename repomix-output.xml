        <div class="wrap page">
            <div class="tag">Interactive</div>
            <h1>API Playground</h1>
            <p class="subtitle">Explore DistLLM's OpenAI-compatible API. Configure parameters and see the generated code.</p>

            <div class="playground">
                <div class="panel">
                    <h3>Request</h3>
                    <div class="form-group">
                        <label for="model">Model</label>
                        <select id="model">
                            <option>meta-llama/Llama-3.2-1B</option>
                            <option selected>meta-llama/Llama-3.2-7B</option>
                            <option>meta-llama/Llama-3.1-8B</option>
                            <option>mistralai/Mistral-7B-v0.3</option>
