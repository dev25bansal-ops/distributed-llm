            <h1>How DistLLM Compares</h1>
            <p class="subtitle">Honest comparisons with other distributed inference solutions. Each has different strengths — choose what fits your needs.</p>

            <!-- Comparison Navigation -->
            <div class="comparison-nav">
                <a href="#petals" class="comp-nav-item active">vs Petals</a>
                <a href="#modal" class="comp-nav-item">vs Modal/RunPod</a>
                <a href="#vllm" class="comp-nav-item">+ vLLM</a>
            </div>

            <!-- DistLLM vs Petals -->
            <section id="petals" class="comparison-section">
                <div class="comp-header">
                    <div class="comp-logos">
                        <div class="comp-logo distllm">D</div>
                        <span class="comp-vs">vs</span>
                        <div class="comp-logo petals">P</div>
                    </div>
                    <h2>DistLLM vs Petals</h2>
                    <p class="comp-subtitle">The only other open-source distributed inference project</p>
                </div>

                <div class="comp-grid">
                    <div class="comp-card">
                        <h3>Architecture</h3>
                        <div class="comp-compare">
                            <div class="comp-item">
                                <div class="comp-item-label">DistLLM</div>
                                <div class="comp-item-value">Full pipeline parallelism across any GPU type. Supports NVIDIA, AMD, Apple Silicon, and CPU.</div>
                            </div>
                            <div class="comp-item">
                                <div class="comp-item-label">Petals</div>
                                <div class="comp-item-value">BitNet-style model sharding. Optimized for specific models (Llama, Falcon). Limited GPU support.</div>
                            </div>
                        </div>
                    </div>

                    <div class="comp-card">
                        <h3>Model Support</h3>
                        <div class="comp-compare">
                            <div class="comp-item">
                                <div class="comp-item-label">DistLLM</div>
                                <div class="comp-item-value">Any HuggingFace model. Auto-partitioning. No model-specific code required.</div>
                            </div>
                            <div class="comp-item">
                                <div class="comp-item-label">Petals</div>
                                <div class="comp-item-value">Requires model-specific integration. Currently supports ~10 models.</div>
                            </div>
                        </div>
                    </div>

                    <div class="comp-card">
                        <h3>Ease of Use</h3>
                        <div class="comp-compare">
                            <div class="comp-item">
                                <div class="comp-item-label">DistLLM</div>
                                <div class="comp-item-value">CLI-first. Docker Compose. OpenAI-compatible API. 5-minute setup.</div>
                            </div>
                            <div class="comp-item">
                                <div class="comp-item-label">Petals</div>
                                <div class="comp-item-value">Python SDK. Requires joining swarm. More complex networking setup.</div>
                            </div>
                        </div>
                    </div>

                    <div class="comp-card">
                        <h3>Performance</h3>
                        <div class="comp-compare">
                            <div class="comp-item">
                                <div class="comp-item-label">DistLLM</div>
                                <div class="comp-item-value">30-90 tok/s on consumer GPUs. Low latency with LAN optimization.</div>
                            </div>
                            <div class="comp-item">
                                <div class="comp-item-label">Petals</div>
                                <div class="comp-item-value">Variable (depends on swarm). Internet latency can be high.</div>
                            </div>
                        </div>
                    </div>
                </div>

