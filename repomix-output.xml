<file path="website/docker-compose.yml">
# Docker Compose for DistLLM Website
# Includes website, analytics, and monitoring

version: '3.8'

services:
  # Website
  website:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: distllm-website
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx-production.conf:/etc/nginx/conf.d/default.conf:ro
      - ./certs:/etc/nginx/certs:ro
      - website-logs:/var/log/nginx
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/health"]
      interval: 30s
      timeout: 3s
      retries: 3
    networks:
      - distllm-net

  # Plausible Analytics (privacy-respecting)
  plausible:
    image: plausible/analytics:latest
    container_name: distllm-analytics
    restart: unless-stopped
    ports:
      - "8000:8000"
    environment:
      - DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@analytics-db:5432/plausible
      - SECRET_KEY_BASE=${SECRET_KEY_BASE}
      - DISABLE_REGISTRATION=invite_only
    depends_on:
      - analytics-db
    networks:
      - distllm-net

  # Analytics Database
  analytics-db:
    image: postgres:15-alpine
    container_name: distllm-analytics-db
    restart: unless-stopped
    environment:
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}  # REQUIRED: Set via environment
      - POSTGRES_DB=plausible
    volumes:
      - analytics-data:/var/lib/postgresql/data
    networks:
      - distllm-net

  # Redis for caching (no host port — internal only)
  redis:
    image: redis:7-alpine
    container_name: distllm-redis
    restart: unless-stopped
    # Ports are not exposed to host — internal to Docker network only.
    # For debugging, uncomment:
    # ports:
    #   - "6379:6379"
    volumes:
      - redis-data:/data
    networks:
      - distllm-net

  # Prometheus for monitoring
  prometheus:
    image: prom/prometheus:latest
    container_name: distllm-prometheus
    restart: unless-stopped
    ports:
      - "9090:9090"
    volumes:
      - ./monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    networks:
      - distllm-net

  # Grafana for dashboards
  grafana:
    image: grafana/grafana:latest
    container_name: distllm-grafana
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_PASSWORD:-admin}
      - GF_SERVER_ROOT_URL=https://grafana.distllm.dev
    volumes:
      - grafana-data:/var/lib/grafana
      - ./monitoring/grafana/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./monitoring/grafana/datasources:/etc/grafana/provisioning/datasources:ro
    depends_on:
      - prometheus
    networks:
      - distllm-net

volumes:
  website-logs:
  analytics-data:
  redis-data:
  prometheus-data:
  grafana-data:

networks:
  distllm-net:
    driver: bridge
</file>

<file path="website/Dockerfile">
# Multi-stage build for DistLLM website
# Stage 1: Build with Vite
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy source files
COPY . .

# Build for production
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine AS production

# Copy custom nginx config (production variant with HSTS, rate limiting, security headers)
COPY nginx-production.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy static files that aren't processed by Vite
COPY --from=builder /app/robots.txt /usr/share/nginx/html/
COPY --from=builder /app/sitemap.xml /usr/share/nginx/html/
COPY --from=builder /app/feed.xml /usr/share/nginx/html/
COPY --from=builder /app/opensearch.xml /usr/share/nginx/html/
COPY --from=builder /app/favicon.svg /usr/share/nginx/html/
COPY --from=builder /app/manifest.json /usr/share/nginx/html/
COPY --from=builder /app/CNAME /usr/share/nginx/html/
COPY --from=builder /app/.htaccess /usr/share/nginx/html/

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/ || exit 1

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
</file>

