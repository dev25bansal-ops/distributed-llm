<file path="deploy/ray/autoscaler.yaml">
# Ray Autoscaler Configuration for Distributed LLM Inference
#
# This configures Ray to automatically provision GPU nodes when
# the coordinator requests workers via placement groups.
#
# Usage:
#   ray up deploy/ray/autoscaler.yaml
#   ray submit deploy/ray/autoscaler.yaml serve_run.py
#
# See: https://docs.ray.io/en/latest/cluster/vms/user-guides/launching-clusters.html

cluster_name: distributed-llm
min_workers: 0
max_workers: 8
target_utilization_fraction: 0.8
idle_timeout_minutes: 5

# Docker configuration (optional)
# docker:
#   image: "distributed-llm:latest"
#   container_name: "ray-llm"
#   pull_before_run: True

# Provider-specific config (AWS example)
provider:
  type: aws
  region: us-west-2
  availability_zone: us-west-2a
  cache_stopped_nodes: True

# Head node (coordinator runs here)
head_node:
  InstanceType: m5.2xlarge
  ImageId: ami-0abcdef1234567890  # Replace with your DLAMI

  # Block device mappings
  BlockDeviceMappings:
    - DeviceName: /dev/sda1
      Ebs:
        VolumeSize: 200

# Worker nodes (GPU instances)
worker_nodes:
  InstanceType: p4d.24xlarge  # 8x A100 40GB
  # Alternative: g5.12xlarge (4x A10G), p3.16xlarge (8x V100)

  # Number of workers per instance type
  # For p4d.24xlarge with 8 GPUs, each worker gets 1 GPU
  # So 8 workers per instance
  MinInstances: 0
  MaxInstances: 8

  # Spot instance config (80% cost savings)
  # InstanceMarketOptions:
  #   MarketType: spot
  #   SpotOptions:
  #     MaxPrice: "12.00"

  BlockDeviceMappings:
    - DeviceName: /dev/sda1
      Ebs:
        VolumeSize: 200
        VolumeType: gp3

# Ray cluster setup commands
setup_commands:
  - pip install -U ray[default]>=2.30.0
  - pip install torch>=2.5.0 transformers>=4.48.0

# Commands to run on the head node
head_setup_commands:
  - pip install -e /home/ubuntu/distributed-llm  # Install project

# File mounts
file_mounts:
  /home/ubuntu/distributed-llm: D:\distributed-llm

# Custom startup commands
head_start_ray_commands:
  - ray stop
  - ulimit -n 65536
  - ray start --head --port=6379 --object-manager-port=8076 --autoscaling-config=~/ray_bootstrap_config.yaml

worker_start_ray_commands:
  - ray stop
  - ray start --address=$RAY_HEAD_IP:6379 --object-manager-port=8076

# How Ray will distribute workers based on resource needs
available_node_types:
  ray.head.default:
    node_config:
      InstanceType: m5.2xlarge
    resources:
      CPU: 8
      memory: 32000000000  # 32GB
  ray.worker.default:
    min_workers: 0
    max_workers: 8
    node_config:
      InstanceType: p4d.24xlarge
    resources:
      CPU: 96
      memory: 1152000000000  # 1.15TB
      GPU: 8
      accelerator_type: A100
</file>

<file path="deploy/ray/ci-workflow.yml">
name: Ray CI

on:
  push:
    branches: [main, master, develop]
  pull_request:
    branches: [main, master, develop]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  PYTHON_VERSION: "3.11"
  RAY_VERSION: "2.30.0"

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - uses: ray-project/setup-ray@v1
        with:
          version: ${{ env.RAY_VERSION }}

      - name: Cache pip
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ hashFiles('**/setup.py', '**/pyproject.toml') }}
          restore-keys: |
            ${{ runner.os }}-pip-

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]"

      - name: Start Ray head node
        run: |
          ray start --head --port=6379 --dashboard-port=8265 --num-cpus=2
          ray status

      - name: Run Ray worker tests
        run: |
          python -m pytest tests/core/test_ray_worker.py -v --timeout=60

      - name: Run Ray coordinator tests
        run: |
          python -m pytest tests/core/test_ray_coordinator.py -v --timeout=120

      - name: Run Ray pipeline tests
        run: |
          python -m pytest tests/core/test_ray_pipeline.py -v --timeout=120

      - name: Run Ray integration tests
        run: |
          python -m pytest tests/ -k "ray" -v --timeout=300 || true

      - name: Stop Ray
        if: always()
        run: ray stop

  lint:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install lint deps
        run: |
          python -m pip install --upgrade pip
          pip install ruff mypy

      - name: Ruff check
        run: python -m ruff check src/

      - name: MyPy check
        run: python -m mypy src/ --ignore-missing-imports || true

  benchmark:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    needs: [test]

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - uses: ray-project/setup-ray@v1
        with:
          version: ${{ env.RAY_VERSION }}

      - name: Install deps
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]"

      - name: Start Ray head node
        run: ray start --head --port=6379 --num-cpus=2

      - name: Run Ray benchmarks
        run: |
          python benchmarks/ray_vs_grpc.py --num-trials 20 --num-runs 3 --output benchmarks/results/ray_ci_results.json

      - name: Upload benchmark results
        uses: actions/upload-artifact@v4
        with:
          name: ray-benchmark-results
          path: benchmarks/results/ray_ci_results.json

      - name: Stop Ray
        if: always()
        run: ray stop
</file>

