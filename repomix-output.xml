<file path=".github/workflows/deploy-website.yml">
# Deploy website to GitHub Pages
name: Deploy Website

on:
  push:
    branches: [main]
    paths:
      - "website/**"
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Pages
        uses: actions/configure-pages@v4

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: website

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
</file>

<file path=".github/workflows/gpu-tests.yml">
# GPU CI Pipeline
#
# Runs tests that require real GPU hardware. These tests verify:
# - Actual CUDA inference (not mocked)
# - PagedAttention with real GPU memory
# - Multi-GPU communication (NCCL)
# - Memory leak detection under GPU load
# - FP16/BF16 numerical stability
#
# Requires: Self-hosted runner with NVIDIA GPU and CUDA toolkit
# Configure: Add self-hosted runner label "gpu" in repository settings

name: GPU Tests

on:
  push:
    branches: [main]
    paths:
      - "src/distllm/**"
      - "tests/**gpu**"
      - "tests/**/test_paged**"
      - "tests/**/test_kv_cache**"
  pull_request:
    branches: [main]
    paths:
      - "src/distllm/**"
  workflow_dispatch:
    inputs:
      model:
        description: "Model to test with"
        default: "roneneldan/TinyStories-1M"
        required: false
      duration:
        description: "Soak test duration (seconds)"
        default: "300"
        required: false

env:
  MODEL_NAME: ${{ github.event.inputs.model || 'roneneldan/TinyStories-1M' }}
  SOAK_DURATION: ${{ github.event.inputs.duration || '300' }}

jobs:
  # ── GPU Unit Tests ──────────────────────────────────────────────
  gpu-unit-tests:
    name: GPU Unit Tests
    runs-on: [self-hosted, gpu, linux]
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          pip install -e ".[self-hosted,dev,testing]"

      - name: Verify GPU availability
        run: |
          python -c "
          import torch
          assert torch.cuda.is_available(), 'CUDA not available'
          print(f'GPU: {torch.cuda.get_device_name(0)}')
          print(f'Memory: {torch.cuda.get_device_properties(0).total_mem / 1e9:.1f} GB')
          print(f'CUDA: {torch.version.cuda}')
          "

      - name: Run GPU-marked tests
        run: |
          pytest tests/ -m "gpu" -v --timeout=120 \
            --junitxml=results/gpu-unit.xml \
            --tb=short
        env:
          NVIDIA_VISIBLE_DEVICES: all

      - name: Upload test results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: gpu-unit-test-results
          path: results/gpu-unit.xml

  # ── GPU Integration Tests (Real Model) ─────────────────────────
  gpu-integration:
    name: GPU Integration (Real Model)
    runs-on: [self-hosted, gpu, linux]
    timeout-minutes: 45
    needs: gpu-unit-tests
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          pip install -e ".[self-hosted,dev,testing]"

      - name: Run real model inference test
        run: |
          python tests/test_distributed.py \
            --model ${{ env.MODEL_NAME }} \
            --compare \
            --dtype float16
        timeout-minutes: 15

      - name: Run pipeline correctness tests
        run: |
          pytest tests/correctness/ -v --timeout=120 \
            --junitxml=results/gpu-correctness.xml \
            -k "not test_tensor_to_bytes"
        env:
          DISTLLM_TEST_MODEL: ${{ env.MODEL_NAME }}

      - name: Upload results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: gpu-integration-results
          path: results/

  # ── GPU Memory Leak Detection ──────────────────────────────────
  gpu-memory-leak:
    name: GPU Memory Leak Detection
    runs-on: [self-hosted, gpu, linux]
    timeout-minutes: 60
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          pip install -e ".[self-hosted,dev,testing]"

      - name: Run memory profiling
        run: |
          pytest tests/profiling/ -v --timeout=300 \
            --memory-profile \
            --junitxml=results/gpu-memory.xml \
            -p no:asyncio
        env:
          DISTLLM_TEST_MODEL: ${{ env.MODEL_NAME }}
          PYTORCH_CUDA_ALLOC_CONF: "expandable_segments:True"

      - name: Check for memory leaks
        run: |
          python -c "
          import torch
          if torch.cuda.is_available():
              allocated = torch.cuda.memory_allocated() / 1e9
              reserved = torch.cuda.memory_reserved() / 1e9
              print(f'Final GPU memory: allocated={allocated:.2f}GB, reserved={reserved:.2f}GB')
              if allocated > 1.0:
                  print('WARNING: High GPU memory after tests - possible leak')
                  exit(1)
          "

      - name: Upload results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: gpu-memory-results
          path: results/

  # ── GPU Soak Test ──────────────────────────────────────────────
  gpu-soak:
    name: GPU Soak Test (${{ github.event.inputs.duration || '300' }}s)
    runs-on: [self-hosted, gpu, linux]
    timeout-minutes: 90
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          pip install -e ".[self-hosted,dev,testing]"

      - name: Run soak test
        run: |
          pytest tests/stability/test_soak.py -v --timeout=3600 \
            --junitxml=results/gpu-soak.xml \
            -p no:asyncio
        env:
          DISTLLM_SOAK_DURATION: ${{ env.SOAK_DURATION }}
          DISTLLM_TEST_MODEL: ${{ env.MODEL_NAME }}

      - name: Upload results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: gpu-soak-results
          path: results/
</file>

<file path=".github/workflows/helm-publish.yml">
# Publish Helm chart to GitHub Pages
#
# This workflow packages the DistLLM Helm chart and publishes it
# to a GitHub Pages-hosted Helm repository. Users can then install
# with:
#
#   helm repo add distllm https://distributed-llm.github.io/helm-charts
#   helm install distllm distllm/distllm

name: Helm Chart Publish

on:
  push:
    branches: [main]
    paths:
      - "integrations/kubernetes/helm/**"
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  publish-chart:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Configure Git
        run: |
          git config user.name "$GITHUB_ACTOR"
          git config user.email "$GITHUB_ACTOR@users.noreply.github.com"

      - name: Install Helm
        uses: azure/setup-helm@v3
        with:
          version: v3.14.0

      - name: Package chart
        run: |
          helm package integrations/kubernetes/helm/distllm \
            --destination .cr-release-packages \
            --version ${{ github.run_number }}.0.0 \
            --app-version 0.4.0

      - name: Publish to GitHub Pages
        uses: helm/chart-releaser-action@v1.6.0
        with:
          charts_dir: integrations/kubernetes/helm
          skip_packaging: true
        env:
          CR_TOKEN: "${{ secrets.GITHUB_TOKEN }}"
</file>

<file path=".github/workflows/integration-test.yml">
# Distributed Pipeline Integration Test
#
# Spins up a real multi-node cluster using Docker Compose and runs
# end-to-end tests against it. This catches bugs that thread-based
# tests miss: real gRPC, real network, real container orchestration.
#
# Tests:
# - Multi-node model loading and inference
# - Node failure recovery
# - Health check propagation
# - API endpoint correctness
# - Streaming responses

name: Distributed Integration Test

on:
  push:
    branches: [main]
    paths:
      - "src/distllm/**"
      - "docker-compose*.yml"
      - "Dockerfile*"
  pull_request:
    branches: [main]
    paths:
      - "src/distllm/**"
      - "docker-compose*.yml"
  workflow_dispatch:

env:
  MODEL_NAME: "roneneldan/TinyStories-1M"
  TOTAL_LAYERS: "8"
  DOCKER_BUILDKIT: 1

jobs:
  # ── Build Docker images ────────────────────────────────────────
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build coordinator image
        uses: docker/build-push-action@v5
        with:
          context: .
          load: true
          tags: distllm:coordinator
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Save image
        run: docker save distllm:coordinator | gzip > distllm-image.tar.gz

      - name: Upload image artifact
        uses: actions/upload-artifact@v4
        with:
          name: docker-image
          path: distllm-image.tar.gz
          retention-days: 1

  # ── Integration tests against real cluster ─────────────────────
  integration:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    needs: build
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Download Docker image
        uses: actions/download-artifact@v4
        with:
          name: docker-image

      - name: Load Docker image
        run: docker load < distllm-image.tar.gz

      - name: Create test network
        run: docker network create distllm-test-net || true

      - name: Start coordinator
        run: |
          docker run -d \
            --name distllm-coordinator \
            --network distllm-test-net \
            -p 8000:8000 \
            -p 50050:50050 \
            -e DISTLLM_LOG_LEVEL=DEBUG \
            -e MODEL_NAME=${{ env.MODEL_NAME }} \
            distllm:coordinator \
            distllm-api --model ${{ env.MODEL_NAME }} --local --port 8000

      - name: Wait for coordinator to be ready
        run: |
          for i in $(seq 1 60); do
            if curl -sf http://localhost:8000/health > /dev/null 2>&1; then
              echo "Coordinator ready after ${i}s"
              exit 0
            fi
            echo "Waiting... ($i/60)"
            sleep 2
          done
          echo "Coordinator failed to start"
          docker logs distllm-coordinator
          exit 1

      - name: Install test dependencies
        run: pip install httpx pytest

      - name: Run API integration tests
        run: |
          python -c "
          import httpx
          import json

          base = 'http://localhost:8000'
          client = httpx.Client(timeout=30.0)

          # Test 1: Health check
          r = client.get(f'{base}/health')
          assert r.status_code == 200, f'Health failed: {r.status_code}'
          print('✓ Health check passed')

          # Test 2: List models
          r = client.get(f'{base}/v1/models')
          assert r.status_code == 200
          print('✓ List models passed')

          # Test 3: Chat completion
          r = client.post(f'{base}/v1/chat/completions', json={
              'model': '${{ env.MODEL_NAME }}',
              'messages': [{'role': 'user', 'content': 'Hello'}],
              'max_tokens': 10,
              'temperature': 0.1,
          })
          assert r.status_code == 200, f'Chat failed: {r.status_code} {r.text}'
          data = r.json()
          assert 'choices' in data
          assert len(data['choices']) > 0
          print(f'✓ Chat completion passed: {data[\"choices\"][0][\"message\"][\"content\"][:50]}...')

          # Test 4: Text completion
          r = client.post(f'{base}/v1/completions', json={
              'model': '${{ env.MODEL_NAME }}',
              'prompt': 'Once upon a time',
              'max_tokens': 10,
          })
          assert r.status_code == 200, f'Completion failed: {r.status_code}'
          print('✓ Text completion passed')

          # Test 5: Streaming
          with client.stream('POST', f'{base}/v1/chat/completions', json={
              'model': '${{ env.MODEL_NAME }}',
              'messages': [{'role': 'user', 'content': 'Tell me a story'}],
              'max_tokens': 20,
              'stream': True,
          }) as r:
              assert r.status_code == 200
              tokens = []
              for line in r.iter_lines():
                  if line.startswith('data: ') and line != 'data: [DONE]':
                      try:
                          chunk = json.loads(line[6:])
                          delta = chunk.get('choices', [{}])[0].get('delta', {})
                          if 'content' in delta:
                              tokens.append(delta['content'])
                      except json.JSONDecodeError:
                          pass
              assert len(tokens) > 0, 'No streaming tokens received'
              print(f'✓ Streaming passed: received {len(tokens)} chunks')

          # Test 6: Error handling
          r = client.post(f'{base}/v1/chat/completions', json={
              'model': 'nonexistent-model',
              'messages': [{'role': 'user', 'content': 'test'}],
          })
          assert r.status_code in (400, 404), f'Expected error, got {r.status_code}'
          print('✓ Error handling passed')

          print('\\nAll integration tests passed!')
          "

      - name: Collect coordinator logs
        if: always()
        run: docker logs distllm-coordinator > coordinator.log 2>&1

      - name: Upload logs
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: integration-logs
          path: coordinator.log

      - name: Cleanup
        if: always()
        run: |
          docker stop distllm-coordinator || true
          docker rm distllm-coordinator || true
          docker network rm distllm-test-net || true
</file>

<file path=".github/workflows/load-testing.yml">
# Load Testing Pipeline
#
# Deploys a real model and runs Locust load tests against it.
# Verifies SLO compliance: p95 latency < 5s, error rate < 1%.
# Runs on PRs touching core code and on-demand for capacity planning.

name: Load Testing

on:
  pull_request:
    paths:
      - "src/distllm/core/**"
      - "src/distllm/api/**"
      - "src/distllm/backends/**"
  workflow_dispatch:
    inputs:
      users:
        description: "Number of concurrent users"
        default: "10"
        required: false
      duration:
        description: "Test duration (e.g., 2m, 5m)"
        default: "2m"
        required: false
      model:
        description: "Model to test"
        default: "roneneldan/TinyStories-1M"
        required: false

env:
  MODEL_NAME: ${{ github.event.inputs.model || 'roneneldan/TinyStories-1M' }}
  USERS: ${{ github.event.inputs.users || '10' }}
  DURATION: ${{ github.event.inputs.duration || '2m' }}

jobs:
  load-test:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.10"

      - name: Install dependencies
        run: |
          pip install -e ".[dev,testing]"
          pip install locust

      - name: Verify GPU/CPU availability
        run: |
          python -c "
          import torch
          if torch.cuda.is_available():
              print(f'GPU: {torch.cuda.get_device_name(0)}')
          else:
              print('Running in CPU mode (slower)')
          "

      - name: Start API server
        run: |
          distllm-api --model ${{ env.MODEL_NAME }} --local --port 8000 &
          echo "Server PID: $!"
          # Wait for server to be ready
          for i in $(seq 1 120); do
            if curl -sf http://localhost:8000/health > /dev/null 2>&1; then
              echo "Server ready after ${i}s"
              break
            fi
            if [ $i -eq 120 ]; then
              echo "Server failed to start"
              exit 1
            fi
            sleep 2
          done

      - name: Run chat load test
        run: |
          locust -f tests/load/locust/scenarios/chat_scenario.py \
            --headless \
            -u ${{ env.USERS }} \
            -r 2 \
            --run-time ${{ env.DURATION }} \
            --host http://localhost:8000 \
            --csv tests/load/results/chat \
            --html tests/load/results/chat_report.html \
            --only-summary

      - name: Run streaming load test
        run: |
          locust -f tests/load/locust/scenarios/streaming_scenario.py \
            --headless \
            -u ${{ env.USERS }} \
            -r 2 \
            --run-time ${{ env.DURATION }} \
            --host http://localhost:8000 \
            --csv tests/load/results/streaming \
            --html tests/load/results/streaming_report.html \
            --only-summary

      - name: Run mixed workload test
        run: |
          locust -f tests/load/locust/scenarios/mixed_scenario.py \
            --headless \
            -u $(( ${{ env.USERS }} * 2 )) \
            -r 4 \
            --run-time ${{ env.DURATION }} \
            --host http://localhost:8000 \
            --csv tests/load/results/mixed \
            --html tests/load/results/mixed_report.html \
            --only-summary

      - name: Generate load test report
        run: |
          python -c "
          import csv
          import os

          results_dir = 'tests/load/results'
          scenarios = ['chat', 'streaming', 'mixed']

          lines = ['# Load Test Results', '']
          all_passed = True

          for scenario in scenarios:
              csv_path = os.path.join(results_dir, f'{scenario}_stats.csv')
              if not os.path.exists(csv_path):
                  lines.append(f'## {scenario.title()} — No data')
                  continue

              with open(csv_path) as f:
                  reader = csv.DictReader(f)
                  for row in reader:
                      if row.get('Name') == 'Aggregated':
                          p95 = float(row.get('95%', 0))
                          failures = int(row.get('Failure Count', 0))
                          requests = int(row.get('Request Count', 0))
                          error_rate = (failures / max(requests, 1)) * 100

                          p95_ok = p95 < 5000  # 5s SLO
                          error_ok = error_rate < 1.0  # 1% SLO

                          lines.append(f'## {scenario.title()}')
                          lines.append(f'- Requests: {requests}')
                          lines.append(f'- p95 latency: {p95:.0f}ms {\"✅\" if p95_ok else \"❌ FAIL (SLO: <5000ms)\"}')
                          lines.append(f'- Error rate: {error_rate:.2f}% {\"✅\" if error_ok else \"❌ FAIL (SLO: <1%)\"}')
                          lines.append('')

                          if not p95_ok or not error_ok:
                              all_passed = False

          report = '\\n'.join(lines)
          with open(os.path.join(results_dir, 'load_report.md'), 'w') as f:
              f.write(report)
          print(report)

          if not all_passed:
              print('\\n❌ SLO violations detected!')
              exit(1)
          else:
              print('\\n✅ All SLOs met!')
          "

      - name: Upload load test results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: load-test-results
          path: tests/load/results/

      - name: Comment PR with load test results
        if: github.event_name == 'pull_request' && always()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const reportPath = 'tests/load/results/load_report.md';
            if (fs.existsSync(reportPath)) {
              const body = fs.readFileSync(reportPath, 'utf8');
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.issue.number,
                body: body,
              });
            }
</file>

<file path=".github/workflows/memory-profile.yml">
name: Memory Profile

on:
  pull_request:
    paths:
      - 'src/distllm/**/*.py'
      - 'tests/**/*.py'
      - 'pyproject.toml'

jobs:
  memory-profile:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev,testing]"

      - name: Run memory profiling tests
        run: |
          pytest tests/profiling/ -v --memory-profile -p no:asyncio

      - name: Run defragmentation unit tests
        run: |
          pytest tests/core/test_memory_defragmenter.py -v --timeout=60 -x

      - name: Profile core operations
        run: |
          python -c "
          import tracemalloc
          from distllm.profiling.ci_profiler import MemoryProfiler
          from distllm.core.batch_scheduler import BatchScheduler, Sequence
          from distllm.communication.serializers import tensor_to_proto, proto_to_tensor
          import torch

          profiler = MemoryProfiler(track_gpu=False)

          reports = profiler.profile_batch({
              'batch_scheduling': lambda: (
                  (s := BatchScheduler(max_batch_size=32, max_tokens_per_batch=4096),
                   [s.add(Sequence(request_id=f'r-{i}', prompt_tokens=[1]*10)) for i in range(50)],
                   s.schedule())),
              'serialization': lambda: (
                  tensor_to_proto(torch.randn(1, 128, 768))),
              'deserialization': lambda: (
                  proto_to_tensor(tensor_to_proto(torch.randn(1, 128, 768)))),
          })

          MemoryProfiler.save_reports(reports, 'memory-profile-report.json')

          # Check for leaks and budget violations
          for r in reports:
              if r.leak_detected:
                  print(f'LEAK: {r.operation} slope={r.leak_slope_mb_per_iter:.2f}MB/iter R²={r.leak_r_squared:.3f}')
              if r.budget_exceeded:
                  print(f'BUDGET EXCEEDED: {r.operation} peak={r.actual_peak_mb:.1f}MB budget={r.budget_mb:.1f}MB')

          # Fail if any leaks or budget violations
          if any(r.leak_detected for r in reports) or any(r.budget_exceeded for r in reports):
              exit(1)
          print('All memory checks passed.')
          "

      - name: Upload memory profile report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: memory-profile-report
          path: memory-profile-report.json
          retention-days: 30
</file>

<file path=".github/workflows/release.yml">
name: Release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write
  packages: write

jobs:
  build-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install -e ".[dev,testing]"
      - run: ruff check src/
      - run: black --check src/
      - run: mypy src/
      - run: pytest -v --cov=distllm --cov-report=xml --cov-fail-under=85 -m "not e2e and not slow"

  build-docker:
    runs-on: ubuntu-latest
    needs: [build-test]
    strategy:
      matrix:
        cuda: ["12.1", "12.6", "12.8"]
    steps:
      - uses: actions/checkout@v4
      - name: Set Dockerfile
        id: dockerfile
        run: |
          if [ "${{ matrix.cuda }}" = "12.8" ]; then
            echo "file=Dockerfile" >> $GITHUB_OUTPUT
          else
            echo "file=Dockerfile.cuda${{ matrix.cuda }}" >> $GITHUB_OUTPUT
          fi
      - name: Set image tags
        id: image_tags
        shell: bash
        run: |
          version="${GITHUB_REF_NAME#v}"
          {
            echo "tags<<EOF"
            echo "ghcr.io/${{ github.repository_owner }}/coordinator:${{ github.ref_name }}-cuda${{ matrix.cuda }}"
            echo "ghcr.io/${{ github.repository_owner }}/coordinator:${version}-cuda${{ matrix.cuda }}"
            echo "ghcr.io/${{ github.repository_owner }}/coordinator:latest-cuda${{ matrix.cuda }}"
            if [ "${{ matrix.cuda }}" = "12.8" ]; then
              echo "ghcr.io/${{ github.repository_owner }}/coordinator:${version}"
              echo "ghcr.io/${{ github.repository_owner }}/coordinator:latest"
              echo "ghcr.io/${{ github.repository_owner }}/operator:${version}"
              echo "ghcr.io/${{ github.repository_owner }}/operator:latest"
            fi
            echo "EOF"
          } >> "$GITHUB_OUTPUT"
      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      - name: Login to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Install cosign
        uses: sigstore/cosign-installer@v3
      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ${{ steps.dockerfile.outputs.file }}
          push: true
          tags: ${{ steps.image_tags.outputs.tags }}
          build-args: |
            CUDA_VERSION=${{ matrix.cuda }}.0
            DISTLLM_VERSION=${{ github.ref_name }}
          labels: |
            org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
            org.opencontainers.image.version=${{ github.ref_name }}
      - name: Sign image with cosign
        env:
          COSIGN_EXPERIMENTAL: "1"
          IMAGE_TAGS: ${{ steps.image_tags.outputs.tags }}
        run: |
          while IFS= read -r image; do
            [ -z "$image" ] && continue
            cosign sign "$image" --yes
          done <<< "$IMAGE_TAGS"

  publish-pypi:
    runs-on: ubuntu-latest
    needs: [build-test]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install build twine
      - run: python -m build
      - run: twine upload dist/* --non-interactive --skip-existing
        env:
          TWINE_USERNAME: __token__
          TWINE_PASSWORD: ${{ secrets.PYPI_API_TOKEN }}

  publish-integrations:
    runs-on: ubuntu-latest
    needs: [build-test]
    strategy:
      fail-fast: false
      matrix:
        package:
          - name: distllm-langchain
            path: integrations/langchain
          - name: distllm-llamaindex
            path: integrations/llamaindex
          - name: distllm-crewai
            path: integrations/crewai
          - name: distllm-litellm
            path: integrations/litellm
          - name: distllm-haystack
            path: integrations/haystack
          - name: distllm-autogen
            path: integrations/autogen
          - name: distllm-ollama-compat
            path: integrations/ollama_compat
          - name: distllm-fastapi
            path: integrations/fastapi_middleware
          - name: distllm-semantic-kernel
            path: integrations/semantic_kernel
          - name: distllm-grpc-client
            path: integrations/grpc_client
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install build twine
      - name: Build ${{ matrix.package.name }}
        working-directory: ${{ matrix.package.path }}
        run: python -m build
      - name: Publish ${{ matrix.package.name }}
        working-directory: ${{ matrix.package.path }}
        run: twine upload dist/* --non-interactive --skip-existing
        env:
          TWINE_USERNAME: __token__
          TWINE_PASSWORD: ${{ secrets.PYPI_API_TOKEN }}

  publish-helm:
    runs-on: ubuntu-latest
    needs: [build-test]
    steps:
      - uses: actions/checkout@v4
      - uses: azure/setup-helm@v3
      - name: Package chart
        run: helm package deploy/helm/
      - name: Upload chart artifact
        uses: actions/upload-artifact@v4
        with:
          name: helm-chart
          path: "*.tgz"

  generate-sbom:
    runs-on: ubuntu-latest
    needs: [build-test]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install cyclonedx-bom
      - run: cyclonedx-py -e . -o sbom.json --format json
      - name: Upload SBOM
        uses: actions/upload-artifact@v4
        with:
          name: sbom
          path: sbom.json

  publish-vscode:
    runs-on: ubuntu-latest
    needs: [build-test]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - run: npm ci
        working-directory: extensions/vscode
      - run: npx vsce package
        working-directory: extensions/vscode
      - name: Upload VSIX
        uses: actions/upload-artifact@v4
        with:
          name: distllm-vsix
          path: extensions/vscode/*.vsix
      - name: Publish to Marketplace
        run: npx vsce publish -p ${{ secrets.VSCE_PAT }}
        working-directory: extensions/vscode

  create-release:
    runs-on: ubuntu-latest
    needs: [build-docker, publish-pypi, publish-helm, generate-sbom, publish-vscode]
    steps:
      - uses: actions/checkout@v4
      - name: Download SBOM
        uses: actions/download-artifact@v4
        with:
          name: sbom
      - name: Download Helm chart
        uses: actions/download-artifact@v4
        with:
          name: helm-chart
      - name: Create GitHub Release
        uses: softprops/action-gh-release@v1
        with:
          generate_release_notes: true
          files: |
            *.tgz
            sbom.json
