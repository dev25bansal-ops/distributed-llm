# Chaos engineering workflow — runs on demand and on schedule
# Tests system resilience under various failure conditions

name: Chaos Engineering

on:
  schedule:
    # Run daily at 3 AM UTC
    - cron: "0 3 * * *"
  workflow_dispatch:
    inputs:
      scenario:
        description: 'Chaos scenario to run'
        required: true
        default: 'all'
        type: choice
        options:
          - all
          - node_failure
          - network_latency
          - network_partition
          - data_corruption
          - cluster
          - oom
      duration:
        description: 'Test duration in seconds'
        required: false
        default: '120'
      target:
        description: 'Target environment URL'
        required: false
        default: 'http://localhost:8000'

jobs:
  node-failure:
    name: Node Failure
    if: ${{ github.event.inputs.scenario == 'all' || github.event.inputs.scenario == 'node_failure' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install -e ".[dev]"
      - name: Run node failure chaos
        run: |
          pytest tests/chaos/test_node_failure.py -v --timeout=60
      - name: Upload chaos results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: chaos-node-failure
          path: tests/chaos/results/
          retention-days: 30

  network-latency:
    name: Network Latency
    if: ${{ github.event.inputs.scenario == 'all' || github.event.inputs.scenario == 'network_latency' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install -e ".[dev]"
      - name: Run latency chaos
        run: |
          pytest tests/chaos/scenarios/network_latency.py -v --timeout=120
      - name: Upload results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: chaos-network-latency
          path: tests/chaos/results/
          retention-days: 30

  data-corruption:
    name: Data Corruption
    if: ${{ github.event.inputs.scenario == 'all' || github.event.inputs.scenario == 'data_corruption' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install -e ".[dev]"
      - name: Run data corruption chaos
        run: |
          pytest tests/chaos/scenarios/data_corruption.py -v --timeout=30
      - name: Upload results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: chaos-data-corruption
          path: tests/chaos/results/
          retention-days: 30

  cluster-chaos:
    name: Cluster Chaos (2-node real cluster)
    if: ${{ github.event.inputs.scenario == 'all' || github.event.inputs.scenario == 'cluster' }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install -e ".[dev]"
      - name: Run cluster chaos tests (2-node real gRPC cluster)
        run: |
          pytest tests/chaos/test_cluster_chaos_integration.py -v --timeout=120
      - name: Run existing cluster chaos tests
        run: |
          pytest tests/chaos/test_cluster_chaos.py -v --timeout=60
      - name: Upload cluster chaos results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: chaos-cluster
          path: tests/chaos/results/
          retention-days: 30

  all-scenarios:
    name: All Chaos Scenarios
    if: ${{ github.event.inputs.scenario == 'all' }}
    runs-on: ubuntu-latest
    needs: [node-failure, network-latency, data-corruption, cluster-chaos]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install -e ".[dev]"
      - name: Run all chaos scenarios
        run: |
          pytest tests/chaos/test_all_scenarios.py -v --timeout=180
      - name: Generate chaos report
        if: always()
        run: |
          echo "## Chaos Engineering Report" > chaos-report.md
          echo "### $(date -u)" >> chaos-report.md
          echo "- Scenario: All" >> chaos-report.md
          echo "- Node failure: ${{ needs.node-failure.result }}" >> chaos-report.md
          echo "- Network latency: ${{ needs.network-latency.result }}" >> chaos-report.md
          echo "- Data corruption: ${{ needs.data-corruption.result }}" >> chaos-report.md
          echo "- Cluster chaos (2-node): ${{ needs.cluster-chaos.result }}" >> chaos-report.md
      - name: Upload report
        uses: actions/upload-artifact@v4
        with:
          name: chaos-report
          path: chaos-report.md
</file>

<file path=".github/workflows/chaos.yml">
name: Chaos Engineering

on:
  schedule:
    # Run weekly on Sunday at 2 AM UTC
    - cron: '0 2 * * 0'
  workflow_dispatch:
    inputs:
      duration:
        description: 'Test duration in seconds'
        default: '3600'
        type: string
      scenarios:
        description: 'Comma-separated scenario names (or "all")'
        default: 'all'
        type: string

env:
  PYTHON_VERSION: '3.11'
  DISTLLM_LOG_LEVEL: 'DEBUG'

jobs:
  chaos-test:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache: 'pip'

      - name: Install dependencies
        run: |
          pip install -e ".[test,chaos]"
          pip install pytest-asyncio pytest-html

      - name: Run chaos scenarios
        id: chaos
        run: |
          python tests/chaos/run_all.py \
            --duration ${{ github.event.inputs.duration || '3600' }} \
            --scenarios ${{ github.event.inputs.scenarios || 'all' }} \
            --output chaos-report.json \
            --junit chaos-results.xml
        continue-on-error: true

      - name: Generate report
        if: always()
        run: |
          python tests/chaos/report.py \
            --input chaos-report.json \
            --output chaos-report.html \
            --format html

      - name: Upload results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: chaos-report-${{ github.run_number }}
          path: |
            chaos-report.json
            chaos-report.html
            chaos-results.xml
          retention-days: 30

      - name: Publish test results
        if: always()
        uses: EnricoMi/publish-unit-test-result-action@v2
        with:
          files: chaos-results.xml
          check_name: Chaos Engineering Results
          comment_mode: always

      - name: Create issue on failure
        if: failure()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            let report = {};
            try {
              report = JSON.parse(fs.readFileSync('chaos-report.json', 'utf8'));
            } catch (e) {}
            
            const body = `## Chaos Engineering Failure
            
            **Run:** ${context.runId}
            **Duration:** ${{ github.event.inputs.duration || '3600' }}s
            **Scenarios:** ${{ github.event.inputs.scenarios || 'all' }}
            
            ### Results
            - Total: ${report.total || 'N/A'}
            - Passed: ${report.passed || 'N/A'}
            - Failed: ${report.failed || 'N/A'}
            
            ### Failed Scenarios
            ${(report.failures || []).map(f => `- ${f.scenario}: ${f.error}`).join('\n') || 'See workflow logs for details'}
            
            [View full report](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId})
            `;
            
            await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: `Chaos Engineering Failure - Run ${context.runId}`,
              body: body,
              labels: ['chaos', 'automated', 'failure']
            });
</file>

<file path=".github/workflows/ci-dashboard.yml">
# CI Dashboard — Publish test results to GitHub Pages
#
# Aggregates test results, coverage, benchmarks, and security scans
# into a browsable dashboard hosted on GitHub Pages.
#
# Access at: https://distributed-llm.github.io/ci-dashboard/

name: CI Dashboard

on:
  push:
    branches: [main]
  workflow_run:
    workflows: ["CI", "GPU Tests", "Chaos Engineering", "Benchmark Regression"]
    types: [completed]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  build-dashboard:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Download workflow artifacts
        uses: actions/github-script@v7
        with:
          script: |
            const workflows = ['CI', 'GPU Tests', 'Chaos Engineering', 'Benchmark Regression'];
            for (const wf of workflows) {
              const runs = await github.rest.actions.listWorkflowRunsForRepo({
                owner: context.repo.owner,
                repo: context.repo.repo,
                workflow: wf,
                per_page: 1,
              });
              if (runs.data.workflow_runs.length > 0) {
                const runId = runs.data.workflow_runs[0].id;
                const artifacts = await github.rest.actions.listWorkflowRunArtifacts({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  run_id: runId,
                });
                console.log(`Found ${artifacts.data.artifacts.length} artifacts for ${wf}`);
              }
            }

      - name: Generate dashboard HTML
        run: |
          mkdir -p dashboard/dist
          python -c "
          import json
          import datetime

          now = datetime.datetime.now(datetime.timezone.utc).isoformat()

          dashboard = {
              'generated_at': now,
              'commit': '${{ github.sha }}',
              'branch': '${{ github.ref_name }}',
              'sections': [
                  {
                      'title': 'Test Results',
                      'description': 'Unit, integration, and E2E test results',
                      'icon': 'test',
                      'link': 'tests/',
                  },
                  {
                      'title': 'Coverage Report',
                      'description': 'Code coverage analysis',
                      'icon': 'coverage',
                      'link': 'coverage/',
                  },
                  {
                      'title': 'Benchmark Results',
                      'description': 'Performance benchmarks and regression analysis',
                      'icon': 'benchmark',
                      'link': 'benchmarks/',
                  },
                  {
                      'title': 'Security Scans',
                      'description': 'SAST, dependency audit, and secrets detection',
                      'icon': 'security',
                      'link': 'security/',
                  },
                  {
                      'title': 'Chaos Engineering',
                      'description': 'Chaos test results and resilience metrics',
                      'icon': 'chaos',
                      'link': 'chaos/',
                  },
                  {
                      'title': 'Load Tests',
                      'description': 'Locust load test results and SLO compliance',
                      'icon': 'load',
                      'link': 'load/',
                  },
              ],
          }

          with open('dashboard/dist/index.json', 'w') as f:
              json.dump(dashboard, f, indent=2)
          "

      - name: Generate dashboard HTML page
        run: |
          cat > dashboard/dist/index.html << 'HTMLEOF'
          <!DOCTYPE html>
          <html lang="en">
          <head>
              <meta charset="UTF-8">
              <meta name="viewport" content="width=device-width, initial-scale=1.0">
              <title>DistLLM CI Dashboard</title>
              <style>
                  * { margin: 0; padding: 0; box-sizing: border-box; }
                  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0d1117; color: #c9d1d9; }
                  .header { background: #161b22; padding: 24px 32px; border-bottom: 1px solid #30363d; }
                  .header h1 { font-size: 24px; color: #f0f6fc; }
                  .header p { color: #8b949e; margin-top: 4px; }
                  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; padding: 32px; }
                  .card { background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 24px; transition: border-color 0.2s; }
                  .card:hover { border-color: #58a6ff; }
                  .card h2 { font-size: 18px; color: #f0f6fc; margin-bottom: 8px; }
                  .card p { color: #8b949e; font-size: 14px; }
                  .card a { display: inline-block; margin-top: 12px; color: #58a6ff; text-decoration: none; }
                  .card a:hover { text-decoration: underline; }
                  .status { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: 500; }
                  .status.pass { background: #1a4d2e; color: #3fb950; }
                  .status.fail { background: #4d1a1a; color: #f85149; }
                  .status.warn { background: #4d3a1a; color: #d29922; }
                  .meta { color: #484f58; font-size: 12px; margin-top: 24px; text-align: center; }
              </style>
          </head>
          <body>
              <div class="header">
                  <h1>DistLLM CI Dashboard</h1>
                  <p>Build: <code id="commit">loading...</code> | Branch: <code id="branch">loading...</code></p>
              </div>
              <div class="grid" id="sections"></div>
              <div class="meta" id="meta"></div>
              <script>
                  fetch('index.json').then(r => r.json()).then(data => {
                      document.getElementById('commit').textContent = data.commit?.substring(0, 8) || 'N/A';
                      document.getElementById('branch').textContent = data.branch || 'N/A';
                      document.getElementById('meta').textContent = 'Generated: ' + data.generated_at;
                      const grid = document.getElementById('sections');
                      data.sections?.forEach(s => {
                          grid.innerHTML += '<div class="card"><h2>' + s.title + '</h2><p>' + s.description + '</p><a href="' + s.link + '">View Results →</a></div>';
                      });
                  });
              </script>
          </body>
          </html>
          HTMLEOF

      - name: Upload pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: dashboard/dist

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build-dashboard
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
</file>

<file path=".github/workflows/ci.yml">
# CI/CD Pipeline: lint → test → benchmark → security scan on every PR

# This is the enhanced CI pipeline that replaces the existing ci.yml.
# It adds: benchmark regression with flame graphs, security scanning,
# container SBOM generation, and comprehensive performance gates.

name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  lint:
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        os: [ubuntu-latest]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install -e ".[dev]"
      - run: ruff check src/ benchmarks/
      - run: black --check src/ benchmarks/
      - name: Run mypy
        run: mypy src/

  test:
    runs-on: ${{ matrix.os }}
    needs: [lint]
    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest]
        python-version: ["3.10", "3.11"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - run: pip install -e ".[dev,testing]"
      - run: pytest -v --cov=distllm --cov-report=xml --cov-fail-under=90 -m "not e2e and not slow and not chaos"
      - name: Test distributed speculative decoder
        run: |
          pytest tests/core/test_remote_draft_model.py -v
          pytest tests/core/test_distributed_speculative_decoder.py -v
          pytest tests/core/test_distributed_speculative_config.py -v
          pytest tests/integration/test_distributed_speculative_e2e.py -v
          pytest tests/correctness/test_dist_spec_matches_greedy.py -v
          pytest tests/correctness/test_determinism.py -v
        shell: bash
      - name: Upload coverage
        if: matrix.os == 'ubuntu-latest'
        uses: codecov/codecov-action@v4
        with:
          file: ./coverage.xml
          fail_ci_if_error: false

  chaos-tests:
    runs-on: ubuntu-latest
    needs: [lint]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install -e ".[dev,testing]"
      - name: Run chaos tests
        run: pytest -v -m chaos --tb=short
      - name: Run integration tests
        run: pytest tests/integration/ -v --tb=short

  security-sast:
    runs-on: ubuntu-latest
    needs: [lint]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install bandit
      - name: Bandit SAST
        run: bandit -r src/ -lll -f json -o bandit-report.json
      - name: Upload SAST report
        uses: actions/upload-artifact@v4
        with:
          name: bandit-report
          path: bandit-report.json

  security-deps:
    runs-on: ubuntu-latest
    needs: [lint]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install pip-audit
      - name: Dependency audit
        run: pip-audit --format json --output dep-audit.json
      - name: Upload dep audit
        uses: actions/upload-artifact@v4
        with:
          name: dep-audit
          path: dep-audit.json

  security-secrets:
    runs-on: ubuntu-latest
    needs: [lint]
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install detect-secrets
      - name: Detect secrets vs baseline
        run: |
          detect-secrets scan src/ deploy/ > .secrets.new.baseline
          python scripts/ci/check_secrets_baseline.py

  benchmark:
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request'
    needs: [test]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install -e ".[dev]"
      - name: Run GPU benchmarks with regression check
        if: ${{ runner.environment == 'gpu' }}
        run: |
          python benchmarks/run.py --model roneneldan/TinyStories-1M --output benchmarks/results.json
          if [ -f benchmarks/baseline.json ]; then
            python benchmarks/regression_check.py \
              --baseline benchmarks/baseline.json \
              --current benchmarks/results.json \
              --threshold 0.10 \
              --flamegraph
          fi
      - name: Run CPU-compatible benchmarks (prefix cache, speculative decoding, network util)
        if: ${{ runner.environment != 'gpu' }}
        run: |
          echo "No GPU runner available — running CPU-compatible regression benchmarks"
          python -c "
import json, sys, os
sys.path.insert(0, 'benchmarks')
from run import (
    benchmark_kv_cache_hit_rate,
    benchmark_spec_accept_rate,
    benchmark_network_util,
    benchmark_throughput_dist,
)

results = {}
for name, fn, kwargs in [
    ('kv-cache-hit-rate', benchmark_kv_cache_hit_rate, {'model': '', 'num_prompts': 20}),
    ('spec-accept-rate', benchmark_spec_accept_rate, {'num_prompts': 20}),
    ('network-util', benchmark_network_util, {'model': 'llama-3-70b', 'max_tokens': 128, 'nodes': 4}),
    ('throughput-dist', benchmark_throughput_dist, {'model': 'llama-3-70b', 'nodes': 4, 'max_tokens': 128, 'num_prompts': 1}),
]:
    r = fn(**kwargs)
    results[name] = {'value': r.target_met, 'mean': r.tokens_per_sec or r.cache_hit_rate_pct or r.acceptance_rate_pct or r.network_util_pct}
    print(f'  {name}: target_met={r.target_met}')

os.makedirs('benchmarks/results', exist_ok=True)
with open('benchmarks/results.json', 'w') as f:
    json.dump({'metrics': results}, f, indent=2)
"
      - name: CPU benchmark regression check vs baseline
        if: ${{ runner.environment != 'gpu' && hashFiles('benchmarks/baseline.json') != '' }}
        run: |
          python benchmarks/regression_check.py \
            --baseline benchmarks/baseline.json \
            --current benchmarks/results.json \
            --threshold 10.0
      - name: Upload benchmark results
        uses: actions/upload-artifact@v4
        with:
          name: benchmark-results
          path: |
            benchmarks/results.json
            benchmarks/flamegraph_*.svg
          retention-days: 90
      - name: PR gate — fail if regression
        if: failure()
        run: |
          echo "❌ Benchmark regression detected. Check benchmark-results artifact for details."
          exit 1

  # ------------------------------------------------------------------
  # Test — framework integrations
  # ------------------------------------------------------------------
  test-integrations:
    runs-on: ubuntu-latest
    needs: [lint]
    strategy:
      fail-fast: false
      matrix:
        integration:
          - langchain
          - llamaindex
          - crewai
          - litellm
          - haystack
          - autogen
          - ollama_compat
          - fastapi_middleware
          - semantic_kernel
          - grpc_client
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install core + integration
        run: |
          pip install -e ".[dev]"
          pip install -e "integrations/${{ matrix.integration }}[dev]" 2>/dev/null || \
            pip install -e "integrations/${{ matrix.integration }}" 2>/dev/null || \
            echo "No setup.py/pyproject.toml for ${{ matrix.integration }}, skipping install"
      - name: Run integration tests
        run: |
          TEST_DIR="integrations/${{ matrix.integration }}/tests"
          if [ -d "$TEST_DIR" ]; then
            pytest "$TEST_DIR" -v --tb=short
          else
            echo "No tests found for ${{ matrix.integration }}, skipping"
          fi

  # ------------------------------------------------------------------
  # Test — Terraform provider
  # ------------------------------------------------------------------
  test-terraform:
    runs-on: ubuntu-latest
    needs: [lint]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "1.22"
          cache-dependency-path: integrations/terraform/provider/go.sum
      - name: Run Terraform provider tests
        working-directory: integrations/terraform/provider
        run: go test ./provider/... -v -count=1

  build-docker:
    runs-on: ubuntu-latest
    needs: [test, security-sast, security-deps]
    strategy:
      matrix:
        cuda: ["12.1", "12.6", "12.8"]
    steps:
      - uses: actions/checkout@v4
      - name: Set Dockerfile
        id: dockerfile
        run: |
          if [ "${{ matrix.cuda }}" = "12.8" ]; then echo "file=Dockerfile" >> $GITHUB_OUTPUT
          else echo "file=Dockerfile.cuda${{ matrix.cuda }}" >> $GITHUB_OUTPUT; fi
      - name: Build image
        run: docker build -t distllm:cuda${{ matrix.cuda }} -f ${{ steps.dockerfile.outputs.file }} --build-arg CUDA_VERSION=${{ matrix.cuda }}.0 .
      - name: Trivy scan
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: distllm:cuda${{ matrix.cuda }}
          format: sarif
          output: trivy-${{ matrix.cuda }}.sarif
          severity: HIGH,CRITICAL
          exit-code: "1"
      - name: Upload scan results
        uses: actions/upload-artifact@v4
        with:
          name: trivy-cuda${{ matrix.cuda }}
          path: trivy-${{ matrix.cuda }}.sarif
      - name: Generate SBOM
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: distllm:cuda${{ matrix.cuda }}
          format: cyclonedx
          output: sbom-cuda${{ matrix.cuda }}.json
      - name: Upload SBOM
        uses: actions/upload-artifact@v4
        with:
          name: sbom-cuda${{ matrix.cuda }}
          path: sbom-cuda${{ matrix.cuda }}.json

  validate-k8s:
    runs-on: ubuntu-latest
    needs: [lint]
    steps:
      - uses: actions/checkout@v4
      - uses: azure/setup-helm@v3
      - uses: azure/setup-kubectl@v4
      - name: Validate Helm chart
        run: |
          helm lint deploy/helm
          helm template distllm deploy/helm --namespace distllm > /tmp/distllm-helm.yaml
          helm template distllm deploy/helm --namespace distllm --set coordinator.ha.enabled=true > /tmp/distllm-helm-ha.yaml
      - name: Validate Kustomize overlays
        run: |
          kubectl kustomize --load-restrictor=LoadRestrictionsNone deploy/kustomize/dev > /tmp/distllm-dev.yaml
          kubectl kustomize --load-restrictor=LoadRestrictionsNone deploy/kustomize/staging > /tmp/distllm-staging.yaml
          kubectl kustomize --load-restrictor=LoadRestrictionsNone deploy/kustomize/production > /tmp/distllm-production.yaml

  vscode-extension:
    runs-on: ubuntu-latest
    needs: [lint]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - run: npm ci
        working-directory: extensions/vscode
      - run: npm run compile
        working-directory: extensions/vscode
      - run: npm run lint
        working-directory: extensions/vscode

  mutation-testing:
    runs-on: ubuntu-latest
    needs: [lint]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -e ".[dev]"
      - name: Run mutation tests on key modules
        run: |
          python tests/mutation/mutate.py src/distllm/cli/benchmark.py tests/cli/test_benchmark.py || true
          python tests/mutation/mutate.py src/distllm/prompts/library.py tests/prompts/test_library.py || true
      - name: Upload mutation results
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: mutation-test-results
          path: tests/mutation/results/
          retention-days: 30

  load-test:
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request'
    needs: [build-docker]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - run: pip install -e ".[dev]" && pip install locust
      - name: Start coordinator + API (local CPU mode)
        run: |
          nohup distllm-api --local --model roneneldan/TinyStories-1M \
            --dtype float32 --port 8000 > /tmp/server.log 2>&1 &
          echo $! > /tmp/server.pid
          for i in $(seq 1 60); do
            curl -s http://localhost:8000/health > /dev/null 2>&1 && break
            sleep 2
          done
          curl -s http://localhost:8000/health || {
            echo "--- server log tail ---"
            tail -50 /tmp/server.log
            exit 1
          }
      - name: Run mixed load test (ramp to 50 users)
        run: |
          locust -f tests/load/locust/locustfile.py \
            --headless -u 50 -r 5 --run-time 3m \
            --host http://localhost:8000 \
            --csv tests/load/results/load_test --csv-full-body \
            --stop-timeout 10
      - name: Check SLO thresholds (p95 < 5s, error rate < 1%)
        run: |
          python tests/load/locust/slo_check.py \
            --csv tests/load/results/load_test_stats.csv \
            --p95-latency-ms 5000 \
            --p99-latency-ms 10000 \
            --error-rate 0.01
      - name: Stop service
        if: always()
        run: kill $(cat /tmp/server.pid) 2>/dev/null || true
      - name: Upload load test artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: load-test-results
          path: tests/load/results/
          retention-days: 30

  fuzz-test:
    runs-on: ubuntu-latest
    needs: [lint]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"
      - name: Install dependencies
        run: |
          pip install -e ".[dev]"
          pip install atheris
      - name: Run fuzz harnesses (pytest mode, 500 iterations each)
        run: |
          python tests/fuzz/run_all.py --iterations 500
      - name: Upload fuzz logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: fuzz-test-results
          path: tests/fuzz/results/
          retention-days: 30

  performance-report:
    runs-on: ubuntu-latest
    if: always()
    needs: [benchmark, load-test, fuzz-test]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          path: artifacts/
      - name: Generate performance report
        run: |
          python tests/load/generate_report.py \
            --artifacts artifacts/ \
            --output artifacts/performance-report.md || true
      - name: Upload report
        uses: actions/upload-artifact@v4
        with:
          name: performance-report
          path: artifacts/performance-report.md
          retention-days: 90
</file>

