        assert stats["unique_nodes"] == 2

    def test_hit_miss_tracking(self):
        idx = CacheIndex()
        idx.store("h1", "node-1", "ref-1")
        idx.lookup("h1")  # hit
        idx.lookup("h99")  # miss
        stats = idx.stats()
        assert stats["hit_count"] == 1
