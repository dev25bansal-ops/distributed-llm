 */

import { escapeHtml } from './utils.js';

// ── Configuration Data ─────────────────────────────────────────────────

const GPU_OPTIONS = [
    { id: 'rtx4090', name: 'RTX 4090', vram: 24, tdp: 450, price: 1599 },
    { id: 'rtx3090', name: 'RTX 3090', vram: 24, tdp: 350, price: 899 },
    { id: 'a100-80gb', name: 'A100 80GB', vram: 80, tdp: 300, price: 15000 },
    { id: 'h100-80gb', name: 'H100 80GB', vram: 80, tdp: 350, price: 25000 },
    { id: 'rtx4080', name: 'RTX 4080', vram: 16, tdp: 320, price: 1199 },
    { id: 'rx7900xtx', name: 'RX 7900 XTX', vram: 24, tdp: 355, price: 899 },
];

const MODEL_OPTIONS = [
    { id: 'llama-3.1-8b', name: 'Llama 3.1 8B', params: '8B', vramRequired: { fp16: 16, int8: 8, int4: 4 } },
    { id: 'llama-3.1-70b', name: 'Llama 3.1 70B', params: '70B', vramRequired: { fp16: 140, int8: 70, int4: 35 } },
    { id: 'llama-3.1-405b', name: 'Llama 3.1 405B', params: '405B', vramRequired: { fp16: 810, int8: 405, int4: 203 } },
    { id: 'mistral-7b', name: 'Mistral 7B', params: '7B', vramRequired: { fp16: 14, int8: 7, int4: 4 } },
    { id: 'mixtral-8x7b', name: 'Mixtral 8x7B', params: '47B', vramRequired: { fp16: 94, int8: 47, int4: 24 } },
    { id: 'qwen-72b', name: 'Qwen 72B', params: '72B', vramRequired: { fp16: 144, int8: 72, int4: 36 } },
];

const QUANTIZATION_OPTIONS = [
    { id: 'fp16', name: 'FP16', desc: 'Full precision, highest quality', quality: 1.0, speed: 1.0 },
    { id: 'int8', name: 'INT8', desc: '8-bit quantization, good balance', quality: 0.95, speed: 1.3 },
    { id: 'int4', name: 'INT4', desc: '4-bit quantization, fastest', quality: 0.85, speed: 1.8 },
];

const NETWORK_OPTIONS = [
    { id: 'lan', name: 'LAN / Local', desc: 'Same network, lowest latency' },
