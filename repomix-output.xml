        .card h2 { font-size: 0.85rem; color: #94a3b8; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.05em; }
        .card h3 { font-size: 0.75rem; color: #64748b; margin: 8px 0 4px; text-transform: uppercase; }
        .stat-row { display: flex; justify-content: space-between; padding: 3px 0; }
        .stat-label { color: #94a3b8; font-size: 0.8rem; }
        .stat-value { color: #e2e8f0; font-weight: 600; font-size: 0.85rem; font-variant-numeric: tabular-nums; }
