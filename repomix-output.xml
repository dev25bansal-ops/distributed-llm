class TestDistributedPreemptionCoordinator:
    def test_init(self):
        from distllm.core.advanced_scheduling import DistributedPreemptionCoordinator
        coord = DistributedPreemptionCoordinator(
            node_ids=["node-0", "node-1", "node-2"],
        )
