az containerapp env create \
  --name distllm-env \
  --resource-group distllm-rg \
  --location eastus

az containerapp create \
  --name distllm \
  --environment distllm-env \
  --image distllm:latest \
  --cpu 16 --memory 64Gi \
  --min-replicas 1 --max-replicas 4
