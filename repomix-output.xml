        store = TenantStore()
        t = store.create_tenant("multi-usage")
        for i in range(5):
            store.record_usage(TenantUsageRecord(
                tenant_id=t.tenant_id, input_tokens=10, output_tokens=20,
                requests=1, model="default",
            ))
        report = store.get_usage_report(t.tenant_id)
