.chat-demo-title { font-size: 11px; color: var(--muted); margin-left: 8px; }

.chat-demo-messages {
    padding: 16px;
    min-height: 200px;
    max-height: 300px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.chat-msg {
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 1.6;
    max-width: 85%;
}

.chat-msg-user {
    background: var(--green-bg);
    border: 1px solid var(--green-bd);
    align-self: flex-end;
    color: var(--text);
}

.chat-msg-assistant {
    background: var(--surface);
    border: 1px solid var(--border);
    align-self: flex-start;
    color: var(--text-secondary);
}

.chat-demo-input-row {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
}

.chat-demo-input {
    flex: 1;
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--text);
    font-size: 13px;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.15s;
}

.chat-demo-input:focus { border-color: var(--green-bd); }

.chat-demo-send {
    background: var(--green);
    color: #000;
    border: none;
    border-radius: var(--radius-xs);
    padding: 10px 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: background 0.15s;
}

.chat-demo-send:hover { background: var(--green-dim); }

.chat-demo-suggestions {
    display: flex;
    gap: 6px;
    padding: 0 16px 12px;
    flex-wrap: wrap;
}

.chat-demo-suggestion {
    font-size: 11px;
    padding: 4px 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    color: var(--dim);
    cursor: pointer;
    transition: all 0.15s;
}

.chat-demo-suggestion:hover { border-color: var(--green-bd); color: var(--text); }

/* ─── A3: GPU Checker ─── */
.gpu-checker-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    max-width: 600px;
    margin: 0 auto;
}

.gpu-checker-row {
    margin-bottom: 16px;
}

.gpu-select {
    width: 100%;
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--text);
    font-size: 13px;
    font-family: var(--font-sans);
    outline: none;
    cursor: pointer;
}

.gpu-count-input {
    width: 100%;
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--text);
    font-size: 13px;
    font-family: var(--font-sans);
    outline: none;
}

.gpu-summary {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
}

.gpu-model-header {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr 0.6fr 0.8fr 0.8fr;
    gap: 8px;
    font-size: 10px;
    font-weight: 600;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
}

.gpu-model-row {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr 0.6fr 0.8fr 0.8fr;
    gap: 8px;
    font-size: 12px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    align-items: center;
}

.gpu-model-row.gpu-fit-yes .gpu-model-name { color: var(--text); }
.gpu-model-row.gpu-fit-no .gpu-model-name { color: var(--dim); }
.gpu-model-row.gpu-fit-no { opacity: 0.5; }
.gpu-model-name { font-weight: 600; }
.gpu-model-family { color: var(--dim); }
.gpu-model-quant { color: var(--green); font-weight: 600; }
.gpu-model-gpus { color: var(--text-secondary); }
.gpu-model-tps { color: var(--dim); }

/* ─── A5: Keyboard Help ─── */
.keyboard-help-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
}

.keyboard-help-overlay.open { display: flex; }

.keyboard-help-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    max-width: 360px;
    width: 90%;
}

.keyboard-help-card h3 {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 16px;
}

.keyboard-help-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.keyboard-help-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--text-secondary);
}

.keyboard-help-row kbd {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text);
}

.keyboard-help-dismiss {
    margin-top: 16px;
    font-size: 11px;
    color: var(--dim);
    text-align: center;
}

/* ─── A6: Model Explorer ─── */
.explorer-filters {
    display: flex;
    gap: 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    align-items: flex-end;
}

.explorer-filter {
    flex: 1;
    min-width: 160px;
}

.explorer-filter label {
    display: block;
    font-size: 12px;
    color: var(--dim);
    margin-bottom: 6px;
}

.explorer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
}

.explorer-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
    transition: all 0.2s var(--ease);
}

.explorer-card:hover { border-color: var(--green-bd); transform: translateY(-2px); }

.explorer-card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
}

.explorer-card-name { font-size: 13px; font-weight: 700; }
.explorer-card-params { font-size: 11px; color: var(--dim); }
.explorer-card-family { font-size: 11px; color: var(--green); margin-bottom: 8px; }
.explorer-card-desc { font-size: 12px; color: var(--dim); line-height: 1.5; margin-bottom: 10px; }
.explorer-card-vram { display: flex; gap: 10px; font-size: 10px; color: var(--text-secondary); margin-bottom: 6px; }
.explorer-card-quant { font-size: 10px; color: var(--dim); }

.explorer-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px;
    color: var(--dim);
    font-size: 14px;
}

/* ─── A7: Enhanced Calculator ─── */
.calc-tco-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 20px;
}

.calc-tco-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
    text-align: center;
}

.calc-tco-label { font-size: 11px; color: var(--dim); margin-bottom: 4px; }
.calc-tco-value { font-size: 20px; font-weight: 800; color: var(--green); letter-spacing: -0.5px; }
.calc-tco-sub { font-size: 11px; color: var(--dim); margin-top: 2px; }

/* ─── A8: Deploy Wizard ─── */
.wizard-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    max-width: 700px;
    margin: 0 auto;
}

.wizard-step {
    margin-bottom: 20px;
}

.wizard-step h4 {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
}

.wizard-options {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.wizard-opt {
    padding: 8px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--text-secondary);
    font-size: 13px;
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
}

.wizard-opt small { font-size: 10px; color: var(--dim); }
.wizard-opt:hover { border-color: var(--border-hover); color: var(--text); }
.wizard-opt.active { border-color: var(--green); background: var(--green-bg); color: var(--text); }

.wizard-code-tabs {
    display: flex;
    gap: 2px;
    margin-bottom: -1px;
    position: relative;
    z-index: 1;
}

.wizard-code-tab {
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 600;
    color: var(--dim);
    background: transparent;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
    cursor: pointer;
    transition: all 0.15s;
}

.wizard-code-tab.active { color: var(--text); background: var(--card); border-color: var(--border); }

.wizard-code-block {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0 var(--radius) var(--radius) var(--radius);
    overflow: hidden;
}

.wizard-code-content { display: none; }
.wizard-code-content.active { display: block; }

.wizard-code-content pre {
    padding: 16px;
    margin: 0;
    overflow-x: auto;
}

.wizard-code-content code {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--text);
}

/* ─── Roadmap ─── */
.roadmap-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    max-width: 800px;
    margin: 0 auto;
}

.roadmap-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
    transition: all 0.2s var(--ease);
}

.roadmap-item:hover { border-color: var(--border-hover); }

.roadmap-status {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 14px;
    flex-shrink: 0;
}

.roadmap-done .roadmap-status { background: var(--green-bg); border: 1px solid var(--green-bd); color: var(--green); }
.roadmap-progress .roadmap-status { background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.2); color: var(--amber); }
.roadmap-planned .roadmap-status { background: var(--surface); border: 1px solid var(--border); color: var(--dim); }

.roadmap-item h3 { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
.roadmap-item p { font-size: 12px; color: var(--dim); line-height: 1.5; }

/* ─── Community Stats ─── */
.community-stats {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-top: 24px;
    flex-wrap: wrap;
}

.community-stat {
    text-align: center;
}

.community-stat-value {
    font-size: 28px;
    font-weight: 800;
    color: var(--green);
    letter-spacing: -1px;
}

.community-stat-label {
    font-size: 11px;
    color: var(--dim);
    margin-top: 2px;
}

/* ─── Sticky Mobile CTA ─── */
.mobile-cta {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--card);
    border-top: 1px solid var(--border);
    padding: 10px 16px;
    z-index: 999;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.3);
}

.mobile-cta .btn {
    width: 100%;
    justify-content: center;
}

@media (max-width: 768px) {
    .mobile-cta { display: block; }
    .roadmap-grid { grid-template-columns: 1fr; }
}

/* ─── Responsive ─── */
@media (max-width: 768px) {
    .explorer-filters { flex-direction: column; }
    .explorer-grid { grid-template-columns: 1fr; }
    .gpu-model-header, .gpu-model-row { grid-template-columns: 1.2fr 0.6fr 0.5fr 0.7fr; }
    .gpu-model-gpus, .gpu-model-tps { display: none; }
    .calc-tco-grid { grid-template-columns: 1fr; }
    .wizard-options { flex-direction: column; }
    .wizard-opt { width: 100%; }
}

/* ─── AI Chatbot (moved from inline) ─── */
.chat-fab { position: fixed; bottom: 24px; right: 24px; width: 56px; height: 56px; border-radius: 50%; background: var(--green); color: #000; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 1000; box-shadow: 0 4px 12px rgba(0,230,118,0.3); transition: transform 0.2s; }
.chat-fab:hover { transform: scale(1.1); }
.chat-window { position: fixed; bottom: 96px; right: 24px; width: 380px; height: 500px; background: var(--card); border: 1px solid var(--border); border-radius: 12px; display: flex; flex-direction: column; z-index: 1001; box-shadow: 0 8px 32px rgba(0,0,0,0.5); }
.chat-header { padding: 14px 16px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; font-size: 14px; font-weight: 700; }
.chat-close { background: none; border: none; color: var(--dim); cursor: pointer; font-size: 16px; }
.chat-messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
.chat-msg { display: flex; }
.chat-msg.user { justify-content: flex-end; }
.chat-msg.bot { justify-content: flex-start; }
.chat-bubble { max-width: 85%; padding: 10px 14px; border-radius: 12px; font-size: 13px; line-height: 1.5; }
.chat-msg.user .chat-bubble { background: var(--green); color: #000; border-bottom-right-radius: 4px; }
.chat-msg.bot .chat-bubble { background: var(--surface); color: var(--text); border: 1px solid var(--border); border-bottom-left-radius: 4px; }
.chat-input-form { padding: 12px; border-top: 1px solid var(--border); display: flex; gap: 8px; }
.chat-input-form input { flex: 1; padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); font-size: 13px; }
.chat-input-form button { width: 40px; height: 40px; border-radius: 50%; background: var(--green); color: #000; border: none; cursor: pointer; font-size: 16px; font-weight: 700; }
.chat-typing { display: flex; gap: 4px; padding: 8px 14px; }
.chat-typing span { width: 6px; height: 6px; border-radius: 50%; background: var(--dim); animation: chatBlink 1.4s infinite; }
.chat-typing span:nth-child(2) { animation-delay: 0.2s; }
.chat-typing span:nth-child(3) { animation-delay: 0.4s; }
@keyframes chatBlink { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }
@media (max-width: 480px) { .chat-window { width: calc(100vw - 32px); right: 16px; bottom: 88px; height: 70vh; } }

/* ─── API Playground (moved from inline) ─── */
.api-pg { display: grid; grid-template-columns: 340px 1fr; gap: 0; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: var(--card); min-height: 520px; }
.api-pg-left { padding: 20px; border-right: 1px solid var(--border); overflow-y: auto; }
.api-pg-left h3 { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.api-pg-desc { font-size: 12px; color: var(--dim); margin-bottom: 16px; }
.api-pg-field { margin-bottom: 12px; }
.api-pg-field label { display: block; font-size: 12px; font-weight: 600; color: var(--dim); margin-bottom: 4px; }
.api-pg-field select, .api-pg-field input[type="text"], .api-pg-field textarea { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--text); font-size: 13px; font-family: inherit; }
.api-pg-field textarea { resize: vertical; }
.api-pg-field input[type="range"] { width: 100%; }
.api-pg-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }
.api-pg-right { display: flex; flex-direction: column; }
.api-pg-tabs { display: flex; border-bottom: 1px solid var(--border); }
.api-pg-tab { padding: 10px 16px; background: none; border: none; color: var(--dim); font-size: 12px; font-weight: 600; cursor: pointer; border-bottom: 2px solid transparent; }
.api-pg-tab.active { color: var(--green); border-bottom-color: var(--green); }
.api-pg-tab:hover { color: var(--text); }
.api-pg-code-wrap { flex: 1; position: relative; overflow: auto; }
.api-pg-code { padding: 16px; font-family: 'JetBrains Mono', monospace; font-size: 12px; line-height: 1.7; color: var(--text); white-space: pre; margin: 0; min-height: 200px; }
.api-pg-copy { position: absolute; top: 8px; right: 8px; padding: 4px 10px; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; color: var(--dim); font-size: 11px; cursor: pointer; }
.api-pg-copy:hover { background: var(--card); color: var(--text); }
.api-pg-response { border-top: 1px solid var(--border); max-height: 200px; overflow: auto; }
.api-pg-response-header { padding: 8px 16px; font-size: 12px; font-weight: 600; color: var(--dim); background: var(--bg); }
.api-pg-response pre { padding: 12px 16px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--text); white-space: pre-wrap; margin: 0; }
@media (max-width: 768px) { .api-pg { grid-template-columns: 1fr; } }

/* ─── Model Recommendation (moved from inline) ─── */
.model-rec-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 24px; }
.model-rec-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
.model-rec-desc { font-size: 13px; color: var(--dim); margin-bottom: 20px; }
.model-rec-form { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; margin-bottom: 20px; }
.model-rec-row { display: flex; flex-direction: column; gap: 4px; }
.model-rec-row label { font-size: 12px; font-weight: 600; color: var(--dim); }
.model-rec-row select, .model-rec-row input { padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--text); font-size: 13px; }
.model-rec-btn { grid-column: 1 / -1; padding: 10px; background: var(--green); color: #000; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px; }
.model-rec-btn:hover { opacity: 0.85; }
.model-rec-results { margin-top: 16px; }
.rec-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px; margin-bottom: 8px; display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; }
.rec-card.best { border-color: var(--green); background: rgba(0,230,118,0.05); }
.rec-model { font-size: 15px; font-weight: 700; }
.rec-quant { font-size: 12px; color: var(--green); font-weight: 600; }
.rec-details { font-size: 12px; color: var(--dim); margin-top: 4px; }
.rec-score { text-align: right; }
.rec-score-val { font-size: 24px; font-weight: 800; color: var(--green); }
.rec-score-label { font-size: 11px; color: var(--dim); }
.rec-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 600; background: rgba(0,230,118,0.15); color: var(--green); margin-left: 8px; }

/* ─── Changelog (moved from inline) ─── */
.cl-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 24px; }
.cl-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
.cl-desc { font-size: 13px; color: var(--dim); margin-bottom: 20px; }
.cl-release { margin-bottom: 24px; }
.cl-release-header { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.cl-version { font-size: 20px; font-weight: 800; color: var(--green); }
.cl-date { font-size: 13px; color: var(--dim); }
.cl-codename { font-size: 13px; color: var(--muted); font-style: italic; }
.cl-breaking-badge { background: #ef4444; color: white; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 700; }
.cl-highlights { list-style: none; margin-bottom: 12px; }
.cl-highlights li { padding: 4px 0; font-size: 13px; color: var(--text-secondary); display: flex; gap: 8px; }
.cl-highlights li::before { content: '✓'; color: var(--green); font-weight: 700; }
.cl-breaking { background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); border-radius: 8px; padding: 12px; margin-bottom: 12px; }
.cl-breaking h4 { font-size: 13px; font-weight: 700; color: #ef4444; margin-bottom: 6px; }
.cl-breaking li { font-size: 12px; color: var(--text-secondary); padding: 3px 0; }
.cl-migration { background: rgba(0,230,118,0.05); border: 1px solid rgba(0,230,118,0.15); border-radius: 8px; padding: 12px; margin-bottom: 12px; }
.cl-migration h4 { font-size: 13px; font-weight: 700; color: var(--green); margin-bottom: 6px; }
.cl-migration .step { display: flex; gap: 8px; padding: 4px 0; font-size: 12px; color: var(--text-secondary); }
.cl-migration .step-num { color: var(--green); font-weight: 700; min-width: 20px; }
.cl-divider { height: 1px; background: var(--border); margin: 24px 0; }
.cl-what-new { background: rgba(88,166,255,0.05); border: 1px solid rgba(88,166,255,0.15); border-radius: 8px; padding: 12px; margin-bottom: 20px; }
.cl-what-new h4 { font-size: 13px; font-weight: 700; color: #58a6ff; margin-bottom: 6px; }
.cl-what-new p { font-size: 12px; color: var(--dim); }

/* ─── Newsletter Archive (moved from inline) ─── */
