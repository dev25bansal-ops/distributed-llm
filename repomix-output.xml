        from distllm.core.advanced_scheduling import DisaggregatedBatchScheduler
        sched = DisaggregatedBatchScheduler(
            prefill_node_ids=["p1"],
            decode_node_ids=["d1"],
        )
        seq = _make_seq("req-1", prompt_len=100)
        sched.add(seq)
        sched.schedule()

        sched.complete_request("req-1")
        stats = sched.stats()
        assert stats["decode_active"] == 0

