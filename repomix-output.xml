        forwarder = MagicMock()
        forwarder.forward_kv_cache.return_value = False
        queue = KVReplicationQueue(forwarder=forwarder)
        queue.enqueue("h1", {}, ["http://node1:8000"])
        result = queue.flush()
        assert result == 0

