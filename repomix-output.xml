                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });

        // Load contributors from GitHub API
        async function loadContributors() {
            const grid = document.getElementById('contributorsGrid');
            try {
                const response = await fetch('https://api.github.com/repos/distributed-llm/distributed-llm/contributors?per_page=30');
                if (!response.ok) throw new Error('API error');
                const contributors = await response.json();

                grid.innerHTML = contributors.map((c, i) => `
                    <a href="${c.html_url}" target="_blank" rel="noopener noreferrer" class="contributor-card" title="${c.login}">
                        <img src="${c.avatar_url}" alt="${c.login}" loading="lazy" width="48" height="48">
                        <span class="contributor-name">${c.login}</span>
                        <span class="contributor-commits">${c.contributions} commits</span>
                    </a>
                `).join('');
            } catch (e) {
                grid.innerHTML = '<p style="color: var(--dim);">Unable to load contributors. <a href="https://github.com/distributed-llm/distributed-llm/graphs/contributors" style="color: var(--green);">View on GitHub</a></p>';
            }
        }

        // Load newsletter archive
        function loadNewsletterArchive() {
            const archive = document.getElementById('newsletterArchive');
            const newsletters = [
                { id: 1, date: '2026-05-28', subject: 'DistLLM v0.4.0 Release', preview: 'Production readiness: graceful shutdown, K8s probes, structured errors, YAML config.' },
                { id: 2, date: '2026-05-14', subject: 'v0.3.0 — Security & Features', preview: 'Breaking changes: API endpoints moved to /v1/, auth required by default, config format changed.' },
                { id: 3, date: '2026-04-20', subject: 'Multi-Node Clusters Are Here', preview: 'Run models across multiple machines with pipeline parallelism. Docker Compose setup included.' },
                { id: 4, date: '2026-03-01', subject: 'Welcome to DistLLM', preview: 'First release! Single-node inference with OpenAI-compatible API. Getting started guide inside.' },
            ];

            archive.innerHTML = `
                <h3>Archive</h3>
                ${newsletters.map(n => `
                    <div class="newsletter-item">
                        <div class="newsletter-date">${n.date}</div>
                        <div class="newsletter-content">
                            <h4>${n.subject}</h4>
                            <p>${n.preview}</p>
                        </div>
                    </div>
                `).join('')}
            `;
        }

        // Initialize
        loadContributors();
        loadNewsletterArchive();
    </script>
