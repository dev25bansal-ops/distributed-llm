.pg-slider-row{margin-bottom:8px}.pg-slider-header{display:flex;justify-content:space-between;font-size:12px;margin-bottom:2px}.pg-slider-label{color:var(--text-secondary)}.pg-slider-value{color:var(--green);font-weight:600;font-family:var(--font-mono)}
