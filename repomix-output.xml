class _InMemorySpanExporter(SpanExporter):
    """Stores exported spans in memory for test assertions."""

    def __init__(self):
        self.spans = []

    def export(self, spans, timeout_millis=30000):
        self.spans.extend(spans)
        return None

    def shutdown(self):
        self.spans.clear()

    def clear(self):
        self.spans.clear()


