    p2p_forwarding: bool = True
    tokens_before_forward: int = 10
    wan_timeout_seconds: int = 60
    max_retries: int = 3
    backoff_base_seconds: float = 1.0

    @field_validator("tokens_before_forward")
    @classmethod
    def validate_tokens_before_forward(cls, v: int) -> int:
        if v < 1:
