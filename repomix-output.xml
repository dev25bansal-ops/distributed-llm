            <!-- Video Demos -->
            <section id="videos" class="learn-section">
                <div class="learn-section-header">
                    <h2>Video Demos</h2>
                    <p>Watch step-by-step video tutorials and demos.</p>
                </div>

                <div class="video-grid">
                    <div class="video-card">
                        <div class="video-thumbnail">
                            <div class="video-play">▶</div>
                            <div class="video-duration">12:34</div>
                        </div>
                        <div class="video-info">
                            <h4>Getting Started with DistLLM</h4>
                            <p>Complete walkthrough from installation to first inference.</p>
                            <span class="video-meta">Beginner · June 2026</span>
                        </div>
                    </div>
                    <div class="video-card">
                        <div class="video-thumbnail">
                            <div class="video-play">▶</div>
                            <div class="video-duration">18:45</div>
                        </div>
                        <div class="video-info">
                            <h4>Multi-Node Pipeline Parallelism</h4>
                            <p>Deep-dive into how DistLLM splits models across GPUs.</p>
                            <span class="video-meta">Intermediate · May 2026</span>
                        </div>
                    </div>
                    <div class="video-card">
                        <div class="video-thumbnail">
                            <div class="video-play">▶</div>
                            <div class="video-duration">25:10</div>
                        </div>
                        <div class="video-info">
                            <h4>Production Deployment Guide</h4>
                            <p>Security, monitoring, and scaling for production workloads.</p>
                            <span class="video-meta">Advanced · May 2026</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Architecture Deep-Dive -->
            <section id="architecture" class="learn-section">
                <div class="learn-section-header">
                    <h2>Architecture Deep-Dive</h2>
                    <p>Animated explainers of distributed inference concepts.</p>
                </div>

                <div class="arch-explainers">
                    <!-- Pipeline Parallelism -->
                    <div class="arch-explainer">
                        <div class="explainer-header">
                            <h3>Pipeline Parallelism</h3>
                            <p>How DistLLM splits model layers across GPUs in a pipeline.</p>
                        </div>
                        <div class="explainer-animation" id="pipelineAnimation">
                            <div class="pipeline-demo">
                                <div class="pipeline-stage">
                                    <div class="stage-gpu">GPU 0</div>
                                    <div class="stage-layers">Layers 0-7</div>
                                    <div class="stage-token" id="token1">Token</div>
                                </div>
                                <div class="pipeline-arrow">→</div>
                                <div class="pipeline-stage">
                                    <div class="stage-gpu">GPU 1</div>
                                    <div class="stage-layers">Layers 8-15</div>
                                    <div class="stage-token" id="token2"></div>
                                </div>
                                <div class="pipeline-arrow">→</div>
                                <div class="pipeline-stage">
                                    <div class="stage-gpu">GPU 2</div>
                                    <div class="stage-layers">Layers 16-23</div>
                                    <div class="stage-token" id="token3"></div>
                                </div>
                                <div class="pipeline-arrow">→</div>
                                <div class="pipeline-stage">
                                    <div class="stage-gpu">GPU 3</div>
                                    <div class="stage-layers">Layers 24-31</div>
                                    <div class="stage-token" id="token4"></div>
                                </div>
                            </div>
                            <button class="explainer-play" id="pipelinePlay">▶ Play Animation</button>
                        </div>
                        <div class="explainer-text">
                            <h4>How It Works</h4>
                            <p>Pipeline parallelism splits the model into sequential stages, each running on a different GPU. Tokens flow through the pipeline:</p>
                            <ol>
                                <li><strong>Stage 1 (GPU 0)</strong>: Processes layers 0-7, passes hidden states to next stage</li>
                                <li><strong>Stage 2 (GPU 1)</strong>: Processes layers 8-15, continues the pipeline</li>
                                <li><strong>Stage 3 (GPU 2)</strong>: Processes layers 16-23</li>
                                <li><strong>Stage 4 (GPU 3)</strong>: Processes layers 24-31, produces output token</li>
                            </ol>
                            <p><strong>Advantage</strong>: Near-linear scaling. 4 GPUs ≈ 3.5-3.8× speedup.</p>
                        </div>
                    </div>

                    <!-- Tensor Parallelism -->
                    <div class="arch-explainer">
                        <div class="explainer-header">
                            <h3>Tensor Parallelism</h3>
                            <p>Splitting individual layers across multiple GPUs.</p>
                        </div>
                        <div class="explainer-animation">
                            <div class="tensor-demo">
                                <div class="tensor-layer">
                                    <div class="tensor-gpu">
                                        <div class="tensor-part" style="background: #00e676;"></div>
                                        <span>GPU 0</span>
                                    </div>
                                    <div class="tensor-gpu">
                                        <div class="tensor-part" style="background: #3b82f6;"></div>
                                        <span>GPU 1</span>
                                    </div>
                                    <div class="tensor-gpu">
                                        <div class="tensor-part" style="background: #f59e0b;"></div>
                                        <span>GPU 2</span>
                                    </div>
                                    <div class="tensor-gpu">
                                        <div class="tensor-part" style="background: #ef4444;"></div>
                                        <span>GPU 3</span>
                                    </div>
                                </div>
                                <div class="tensor-label">Single Layer (e.g., Attention)</div>
                            </div>
                        </div>
                        <div class="explainer-text">
                            <h4>How It Works</h4>
                            <p>Tensor parallelism splits individual matrix multiplications across GPUs. Each GPU computes a portion of the layer:</p>
                            <ul>
                                <li><strong>Column Parallel</strong>: Split weight matrix columns across GPUs</li>
                                <li><strong>Row Parallel</strong>: Split weight matrix rows across GPUs</li>
                                <li><strong>AllReduce</strong>: Combine results after each layer</li>
                            </ul>
                            <p><strong>Best for</strong>: GPUs with high-bandwidth interconnect (NVLink, InfiniBand).</p>
                        </div>
                    </div>

                    <!-- Sequence Parallelism -->
                    <div class="arch-explainer">
                        <div class="explainer-header">
                            <h3>Sequence Parallelism</h3>
                            <p>Processing different parts of the input sequence in parallel.</p>
                        </div>
                        <div class="explainer-animation">
                            <div class="sequence-demo">
                                <div class="sequence-input">
                                    <div class="seq-token" style="background: #00e676;">The</div>
                                    <div class="seq-token" style="background: #00e676;">quick</div>
                                    <div class="seq-token" style="background: #00e676;">brown</div>
                                    <div class="seq-token" style="background: #3b82f6;">fox</div>
                                    <div class="seq-token" style="background: #3b82f6;">jumps</div>
                                    <div class="seq-token" style="background: #3b82f6;">over</div>
                                    <div class="seq-token" style="background: #f59e0b;">the</div>
                                    <div class="seq-token" style="background: #f59e0b;">lazy</div>
                                    <div class="seq-token" style="background: #f59e0b;">dog</div>
                                </div>
                                <div class="sequence-gpus">
                                    <span>GPU 0</span>
                                    <span>GPU 1</span>
                                    <span>GPU 2</span>
                                </div>
                            </div>
                        </div>
                        <div class="explainer-text">
                            <h4>How It Works</h4>
                            <p>Sequence parallelism splits the input sequence across GPUs. Each GPU processes a different part of the sequence:</p>
                            <ul>
                                <li><strong>Long sequences</strong>: Split 8K+ token sequences across 4 GPUs</li>
                                <li><strong>KV Cache</strong>: Each GPU maintains KV cache for its sequence portion</li>
                                <li><strong>Communication</strong>: Minimal inter-GPU communication required</li>
                            </ul>
                            <p><strong>Best for</strong>: Long-context inference (8K-128K tokens).</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
    <footer>
        <div class="wrap">
            <div class="ft-bottom" style="border-top: none; padding-top: 0;">
                <span>&copy; 2026 DistLLM. Apache 2.0 License.</span>
                <div class="ft-social">
                    <a href="https://github.com/distributed-llm/distributed-llm" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><use href="#icon-github"/></svg></a>
                </div>
            </div>
        </div>
    </footer>
    <script defer data-domain="distllm.dev" src="https://plausible.io/js/script.js"></script>
    <script type="module">
        // Pipeline animation
        document.getElementById('pipelinePlay')?.addEventListener('click', async () => {
            const tokens = ['token1', 'token2', 'token3', 'token4'];
            for (let i = 0; i < tokens.length; i++) {
                const el = document.getElementById(tokens[i]);
                if (el) {
                    el.textContent = '●';
                    el.style.opacity = '1';
                    await new Promise(r => setTimeout(r, 800));
                    if (i < tokens.length - 1) {
                        el.style.opacity = '0.3';
                    }
                }
            }
            // Reset after animation
            setTimeout(() => {
                tokens.forEach(id => {
                    const el = document.getElementById(id);
                    if (el) {
                        el.textContent = id === 'token1' ? 'Token' : '';
                        el.style.opacity = id === 'token1' ? '1' : '0';
                    }
                });
            }, 2000);
        });
    </script>
</body>
</html>
