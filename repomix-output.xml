from typing import Optional
from pydantic import BaseModel


class OperatorConfig(BaseModel):
    """Configuration for the DistLLM Kubernetes operator."""

    namespace: str = "default"
    image: str = "distributed-llm:latest"
    image_pull_policy: str = "IfNotPresent"
    coordinator_port: int = 8000
    worker_port: int = 50051
    default_replicas: int = 1
    default_model: str = "distributed-llm"
    default_cpu: str = "4"
    default_memory: str = "16Gi"
    default_gpu: Optional[str] = "1"
</file>

<file path="integrations/kubernetes/operator/distllm_operator/crd.yaml">
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: distllmclusters.distllm.ai
spec:
  group: distllm.ai
  names:
    kind: DistLLMCluster
    plural: distllmclusters
    singular: distllmcluster
    shortNames:
      - dlc
  scope: Namespaced
  versions:
    - name: v1
      served: true
      storage: true
      schema:
        openAPIV3Schema:
          type: object
          properties:
            spec:
              type: object
              properties:
                replicas:
                  type: integer
                  minimum: 0
                  default: 1
                  description: Number of worker nodes
                model:
                  type: string
                  default: "distributed-llm"
                  description: Model to serve
                resources:
                  type: object
                  properties:
                    cpu:
                      type: string
                      default: "4"
                    memory:
                      type: string
                      default: "16Gi"
                    gpu:
                      type: string
                      default: "1"
              required: []
            status:
              type: object
              properties:
                phase:
                  type: string
