            predictor._history["aws:g5.xlarge:us-east-1"]
        )
        assert vol > 0
        assert isinstance(vol, float)

    def test_volatility_requires_three_points(self):
        predictor = PreemptionPredictor()
        vol = predictor._compute_volatility([0.50, 0.55])
