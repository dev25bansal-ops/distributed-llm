        assert buffer._flush_handler is None
        assert buffer._flush_on_special == {"\n", ".", "!"}
        assert buffer._batch.token_count == 0
        assert buffer._total_tokens == 0
        assert buffer._total_batches == 0

    def test_custom_values(self):
