async def _async_sleep(seconds):
    """Async sleep helper compatible with Python 3.14."""
    await _sleep_raw(seconds)


async def _sleep_raw(delay):
    """asyncio sleep wrapper."""
    import asyncio
    await asyncio.sleep(delay)


