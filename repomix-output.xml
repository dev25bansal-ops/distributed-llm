                                ${MODEL_OPTIONS.map(m => `<option value="${m.id}" ${m.id === state.model ? 'selected' : ''}>${m.name} (${m.params})</option>`).join('')}
                            </select>
                        </div>
                        <div class="deploy-field">
                            <label>Quantization</label>
                            <select id="deployQuantization">
                                ${QUANTIZATION_OPTIONS.map(q => `<option value="${q.id}" ${q.id === state.quantization ? 'selected' : ''}>${q.name} - ${q.desc}</option>`).join('')}
                            </select>
                        </div>
                    </div>

                    <!-- Network & Security -->
                    <div class="deploy-section">
                        <h4>Network & Security</h4>
                        <div class="deploy-field">
                            <label>Network</label>
                            <select id="deployNetwork">
                                ${NETWORK_OPTIONS.map(n => `<option value="${n.id}" ${n.id === state.network ? 'selected' : ''}>${n.name} - ${n.desc}</option>`).join('')}
                            </select>
                        </div>
                        <div class="deploy-field">
                            <label>Security</label>
                            <select id="deploySecurity">
                                ${SECURITY_PRESETS.map(s => `<option value="${s.id}" ${s.id === state.security ? 'selected' : ''}>${s.name} - ${s.desc}</option>`).join('')}
                            </select>
                        </div>
                    </div>

                    <!-- Output Format -->
                    <div class="deploy-section">
                        <h4>Output Format</h4>
                        <div class="deploy-tabs">
                            <button class="deploy-tab ${state.outputFormat === 'docker-compose' ? 'active' : ''}" data-format="docker-compose">Docker Compose</button>
                            <button class="deploy-tab ${state.outputFormat === 'kubernetes' ? 'active' : ''}" data-format="kubernetes">Kubernetes</button>
                            <button class="deploy-tab ${state.outputFormat === 'terraform' ? 'active' : ''}" data-format="terraform">Terraform</button>
                            <button class="deploy-tab ${state.outputFormat === 'ansible' ? 'active' : ''}" data-format="ansible">Ansible</button>
                        </div>
                    </div>
                </div>

                <!-- Generated Output -->
                <div class="deploy-output">
                    <div class="deploy-output-header">
                        <span class="deploy-output-title">${getOutputTitle(state.outputFormat)}</span>
                        <button class="deploy-copy" id="deployCopy">Copy</button>
                    </div>
                    <pre class="deploy-code"><code id="deployCode">${escapeHtml(generateOutput(state))}</code></pre>
                </div>

                <!-- VRAM Calculator -->
                <div class="deploy-vram">
                    <h4>VRAM Estimation</h4>
                    <div class="deploy-vram-grid">
                        <div class="deploy-vram-item">
                            <span class="deploy-vram-label">Required VRAM</span>
                            <span class="deploy-vram-value">${calculateRequiredVRAM(state)}GB</span>
                        </div>
                        <div class="deploy-vram-item">
                            <span class="deploy-vram-label">Available VRAM</span>
                            <span class="deploy-vram-value">${calculateAvailableVRAM(state)}GB</span>
                        </div>
                        <div class="deploy-vram-item">
                            <span class="deploy-vram-label">Utilization</span>
                            <span class="deploy-vram-value">${calculateVRAMUtilization(state)}%</span>
                        </div>
                    </div>
                </div>
            </div>
        `;

        // Add event listeners
        setupEventListeners();
    }

    function setupEventListeners() {
        const selects = container.querySelectorAll('select');
        selects.forEach(select => {
            select.addEventListener('change', (e) => {
                state[e.target.id.replace('deploy', '').toLowerCase()] = e.target.value;
                render();
            });
        });

        const range = container.querySelector('input[type="range"]');
        if (range) {
            range.addEventListener('input', (e) => {
                state.gpuCount = parseInt(e.target.value);
                container.querySelector('.deploy-range-value').textContent = `${state.gpuCount} GPUs`;
            });
            range.addEventListener('change', () => render());
        }

        const tabs = container.querySelectorAll('.deploy-tab');
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                state.outputFormat = tab.dataset.format;
                render();
            });
        });

        const copyBtn = container.querySelector('#deployCopy');
        if (copyBtn) {
            copyBtn.addEventListener('click', () => {
                const code = container.querySelector('#deployCode').textContent;
                navigator.clipboard.writeText(code).then(() => {
                    copyBtn.textContent = 'Copied!';
                    setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
                });
            });
        }
    }

    render();
}

function getOutputTitle(format) {
    const titles = {
        'docker-compose': 'docker-compose.yml',
        'kubernetes': 'Kubernetes Manifests',
        'terraform': 'Terraform Module',
        'ansible': 'Ansible Playbook',
    };
    return titles[format] || format;
}

function generateOutput(state) {
    const config = {
        gpus: { gpuType: state.gpuType, count: state.gpuCount },
        model: { model: state.model },
        quantization: { level: state.quantization },
        network: { type: state.network },
        security: { preset: state.security },
    };

    switch (state.outputFormat) {
        case 'docker-compose': return generateDockerCompose(config);
        case 'kubernetes': return generateKubernetesManifests(config);
        case 'terraform': return generateTerraformModule(config);
        case 'ansible': return generateAnsiblePlaybook(config);
        default: return '# Select a format';
    }
}

function calculateRequiredVRAM(state) {
    const model = MODEL_OPTIONS.find(m => m.id === state.model);
    const quant = QUANTIZATION_OPTIONS.find(q => q.id === state.quantization);
    return model.vramRequired[quant.id] || 0;
}

function calculateAvailableVRAM(state) {
    const gpu = GPU_OPTIONS.find(g => g.id === state.gpuType);
    return gpu.vram * state.gpuCount;
}

function calculateVRAMUtilization(state) {
    const required = calculateRequiredVRAM(state);
    const available = calculateAvailableVRAM(state);
    return available > 0 ? Math.round((required / available) * 100) : 0;
}
