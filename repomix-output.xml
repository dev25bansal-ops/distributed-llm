    <script>
        const modelEl=document.getElementById('model'),msgEl=document.getElementById('message'),tempEl=document.getElementById('temperature'),maxEl=document.getElementById('maxTokens'),streamEl=document.getElementById('stream');
        const tempVal=document.getElementById('tempVal'),maxVal=document.getElementById('maxTokensVal'),streamVal=document.getElementById('streamVal');
        const tempDisp=document.getElementById('tempDisplay'),maxDisp=document.getElementById('maxDisplay'),streamDisp=document.getElementById('streamDisplay');
        const codeOut=document.getElementById('codeOutput');
        let activeLang='curl';
        function updateCode(){
            const m=modelEl.value,msg=msgEl.value,t=tempEl.value,mt=maxEl.value,s=streamEl.checked;
            const body=JSON.stringify({model:m,messages:[{role:"user",content:msg}],temperature:parseFloat(t),max_tokens:parseInt(mt),stream:s},null,2);
            const codes={
curl:`curl http://localhost:8000/v1/chat/completions \\
  -H "Content-Type: application/json" \\
  -H "Authorization: Bearer your-api-key" \\
  -d '${body}'`,
python:`import openai

client = openai.OpenAI(
    base_url="http://localhost:8000/v1",
    api_key="your-api-key",
)

response = client.chat.completions.create(
    model="${m}",
    messages=[{"role": "user", "content": "${msg.replace(/"/g,'\\"')}"}],
    temperature=${t},
    max_tokens=${mt},
    stream=${s},
)

for chunk in response:
    print(chunk.choices[0].delta.content, end="")`,
javascript:`import OpenAI from "openai";

const client = new OpenAI({
  baseURL: "http://localhost:8000/v1",
  apiKey: "your-api-key",
});

const stream = await client.chat.completions.create({
  model: "${m}",
  messages: [{ role: "user", content: "${msg.replace(/"/g,'\\"')}" }],
  temperature: ${t},
  max_tokens: ${mt},
  stream: ${s},
});

for await (const chunk of stream) {
  process.stdout.write(chunk.choices[0].delta.content ?? "");
}`
            };
            codeOut.textContent=codes[activeLang]||codes.curl;
        }
        document.querySelectorAll('.code-tab').forEach(tab=>{
            tab.addEventListener('click',()=>{
                document.querySelectorAll('.code-tab').forEach(t=>t.classList.remove('active'));
                tab.classList.add('active');
                activeLang=tab.dataset.lang;
                updateCode();
            });
        });
        [modelEl,msgEl,tempEl,maxEl,streamEl].forEach(el=>el.addEventListener('input',()=>{
            tempVal.textContent=tempEl.value;tempDisp.textContent=tempEl.value;
            maxVal.textContent=maxEl.value;maxDisp.textContent=maxEl.value;
            const sv=streamEl.value==='1';streamVal.textContent=sv;streamDisp.textContent=sv;
            updateCode();
        }));
        streamEl.addEventListener('input',()=>{const sv=streamEl.value==='1';streamDisp.textContent=sv;updateCode()});
        updateCode();
    </script>

