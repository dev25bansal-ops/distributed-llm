class ModelSpec:
    key: str
    hf_name: str
    param_count_b: float
    hidden_dim: int
    num_layers: int
    num_heads: int
    vocab_size: int
    single_gpu_tok_s: float       # empirical tok/s on 1x H100 (batch=1)
    single_gpu_ttft_ms: float     # empirical TTFT on 1x H100
    vram_per_gpu_gb: float        # approximate VRAM for inference

MODEL_REGISTRY: dict[str, ModelSpec] = {
    "smol135m": ModelSpec(
