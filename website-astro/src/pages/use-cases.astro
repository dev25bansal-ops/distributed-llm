---
import PageLayout from "../layouts/PageLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { USE_CASES } from "../data/use-cases";
---

<PageLayout
  title="Use Cases"
  description="Home AI labs, healthcare, finance, education, legal, and edge — private inference on hardware you own."
>
  <section class="container-site py-14">
    <SectionHeading
      eyebrow="Use cases"
      title="Built for wherever the data lives"
      lead="If the compute is yours and the data must stay local, DistLLM turns that hardware into a serving cluster."
      level={1}
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {USE_CASES.map((uc) => (
        <article class="flex flex-col rounded-2xl border border-line bg-surface p-7 shadow-sm transition-shadow hover:shadow-card">
          <span class="text-3xl" aria-hidden="true">{uc.icon}</span>
          <h2 class="mt-4 text-lg font-semibold">{uc.industry}</h2>
          <p class="mt-1 font-display text-base font-semibold text-brand-700">{uc.headline}</p>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{uc.body}</p>
          <ul class="mt-4 space-y-1.5">
            {uc.points.map((p) => (
              <li class="flex items-start gap-2 text-xs text-muted">
                <span class="mt-0.5 text-brand-600">✓</span> {p}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</PageLayout>
