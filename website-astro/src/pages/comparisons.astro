---
import PageLayout from "../layouts/PageLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { COMPARISONS } from "../data/comparisons";
---

<PageLayout
  title="Comparisons"
  description="How DistLLM compares with Petals, cloud GPU platforms, and vLLM."
>
  <section class="container-site py-14">
    <SectionHeading
      eyebrow="Comparisons"
      title="Where DistLLM fits"
      lead="Different tools solve different layers of the inference problem. Here is the honest map."
    />
    <div class="mt-12 space-y-10">
      {COMPARISONS.map((c) => (
        <section class="rounded-2xl border border-line bg-surface p-7 shadow-sm">
          <h2 class="text-2xl">{c.vs}</h2>
          <p class="mt-3 max-w-3xl leading-relaxed text-muted">{c.summary}</p>
          <div class="mt-6 overflow-x-auto rounded-xl border border-line">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b-2 border-line bg-sunken">
                  <th class="px-4 py-2.5 font-semibold">Aspect</th>
                  <th class="px-4 py-2.5 font-semibold">DistLLM</th>
                  <th class="px-4 py-2.5 font-semibold">Alternative</th>
                </tr>
              </thead>
              <tbody>
                {c.rows.map((r) => (
                  <tr class="border-b border-line last:border-0">
                    <td class="px-4 py-2.5 font-medium">{r.aspect}</td>
                    <td class="px-4 py-2.5 text-muted">{r.distllm}</td>
                    <td class="px-4 py-2.5 text-muted">{r.other}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>
  </section>
</PageLayout>
