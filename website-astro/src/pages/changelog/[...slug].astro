---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import { formatDate } from "../../lib/format";

export async function getStaticPaths() {
  const entries = await getCollection("changelog");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PageLayout title={`v${entry.data.version}`} description={`DistLLM v${entry.data.version} release notes`}>
  <article class="container-site max-w-3xl py-14">
    <div class="flex items-center gap-3">
      <h1 class="font-display text-4xl font-bold">v{entry.data.version}</h1>
      {entry.data.breaking && (
        <span class="rounded-full bg-pop-100 px-2.5 py-0.5 text-xs font-semibold text-pop-500">Breaking changes</span>
      )}
      <time class="text-sm text-faint" datetime={entry.data.releaseDate.toISOString()}>
        {formatDate(entry.data.releaseDate)}
      </time>
    </div>
    <div class="prose-doc mt-8">
      <Content />
    </div>
  </article>
</PageLayout>
