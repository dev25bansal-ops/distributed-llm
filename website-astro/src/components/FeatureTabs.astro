---
import type { Feature } from "../data/features";

interface Props { features: Feature[] }
const { features } = Astro.props;
---

<div data-feature-tabs class="mx-auto max-w-4xl">
  <div class="flex flex-wrap justify-center gap-2" role="tablist" aria-label="Capabilities">
    {features.map((f, i) => (
      <button
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        data-ftab-btn={f.id}
        class:list={[
          "rounded-full px-5 py-2.5 text-sm font-semibold transition-colors",
          i === 0
            ? "bg-brand-600 text-white shadow-sm"
            : "border border-line bg-surface text-muted hover:border-brand-300 hover:text-ink",
        ]}
      >
        {f.title}
      </button>
    ))}
  </div>

  {features.map((f, i) => (
    <div role="tabpanel" data-ftab-panel={f.id} hidden={i !== 0} class="mt-8">
      <div class="grid gap-6 rounded-2xl border border-line bg-surface p-8 shadow-card md:grid-cols-2">
        <div>
          <h3 class="text-2xl">{f.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{f.tagline}</p>
          <ul class="mt-4 space-y-2">
            {f.bullets.map((b) => (
              <li class="flex items-start gap-2 text-sm text-muted">
                <span class="mt-0.5 text-brand-600">✓</span> {b}
              </li>
            ))}
          </ul>
        </div>
        {f.code && (
          <div class="relative self-start overflow-hidden rounded-xl bg-[#131a16] p-4">
            <p class="mb-2 font-mono text-xs text-white/50">{f.code.label}</p>
            <pre class="overflow-x-auto font-mono text-xs leading-relaxed text-[#d5f5e3]"><code>{f.code.code}</code></pre>
            <button
              class="absolute top-2 right-2 rounded-md border border-white/15 px-2 py-1 text-xs text-white/70 hover:text-white"
              data-copy={f.code.code}
            >
              Copy
            </button>
          </div>
        )}
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-feature-tabs]").forEach((root) => {
    const btns = root.querySelectorAll<HTMLButtonElement>("[data-ftab-btn]");
    const panels = root.querySelectorAll<HTMLElement>("[data-ftab-panel]");
    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.ftabBtn;
        btns.forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-selected", active ? "true" : "false");
          b.classList.toggle("bg-brand-600", active);
          b.classList.toggle("text-white", active);
          b.classList.toggle("shadow-sm", active);
          b.classList.toggle("border-line", !active);
          b.classList.toggle("text-muted", !active);
        });
        panels.forEach((p) => ((p.hidden = p.dataset.ftabPanel !== id)));
      });
    });
  });
</script>
