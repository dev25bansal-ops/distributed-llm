---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "center" | "left";
  /** Heading level for the title. Pages use 1 when this is the page hero; sections use 2. */
  level?: 1 | 2;
}
const { eyebrow, title, lead, align = "center", level = 2 } = Astro.props;
const Tag = level === 1 ? "h1" : "h2";
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]}>
  {eyebrow && (
    <p class="inline-block rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold tracking-wider text-brand-700 uppercase">
      {eyebrow}
    </p>
  )}
  <Tag class="mt-4 text-4xl">{title}</Tag>
  {lead && <p class="mt-3 text-lg text-muted">{lead}</p>}
</div>
