---
interface Props {
  tier: {
    name: string;
    price: string;
    period: string;
    description: string;
    cta: string;
    href: string;
    featured: boolean;
    badge?: string;
    features: string[];
  };
}
const { tier } = Astro.props;
---

<div
  class:list={[
    "relative flex flex-col rounded-2xl border bg-surface p-8",
    tier.featured ? "border-brand-500 shadow-card ring-1 ring-brand-200" : "border-line shadow-sm",
  ]}
>
  {tier.badge && (
    <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-accent-500 px-3 py-1 text-xs font-semibold text-white">
      {tier.badge}
    </span>
  )}
  <h3 class="text-lg font-semibold">{tier.name}</h3>
  <p class="mt-2">
    <span class="font-display text-4xl font-bold">{tier.price}</span>
    {tier.period && <span class="text-muted"> {tier.period}</span>}
  </p>
  <p class="mt-3 text-sm text-muted">{tier.description}</p>
  <ul class="mt-6 flex-1 space-y-2.5">
    {tier.features.map((f) => (
      <li class="flex items-start gap-2 text-sm text-muted">
        <span class="mt-0.5 text-brand-600">✓</span> {f}
      </li>
    ))}
  </ul>
  <a
    href={tier.href}
    class:list={[
      "mt-8 rounded-xl px-4 py-3 text-center text-sm font-semibold transition-colors",
      tier.featured
        ? "bg-brand-600 text-white hover:bg-brand-700"
        : "border border-line text-ink hover:border-brand-300 hover:text-brand-700",
    ]}
  >
    {tier.cta}
  </a>
</div>
