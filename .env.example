# ════════════════════════════════════════════════════════════════
# DistLLM — Environment Configuration
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables are optional unless marked [REQUIRED].
# Variables prefixed with DISTLLM_ can also be set in config.yaml.
# ════════════════════════════════════════════════════════════════

# ── Profile ─────────────────────────────────────────────────────
# Runtime profile: dev, staging, or production
# DISTLLM_PROFILE=dev

# ── Coordinator / API Server ────────────────────────────────────
# DISTLLM_COORDINATOR_HOST=127.0.0.1
# DISTLLM_COORDINATOR_PORT=50050
# DISTLLM_API_HOST=127.0.0.1
# DISTLLM_API_PORT=8000

# ── Model Configuration ─────────────────────────────────────────
# MODEL_NAME=Qwen/Qwen2.5-3B
# DTYPE=bfloat16
# QUANTIZATION=

# ── Worker Nodes ────────────────────────────────────────────────
# DISTLLM_WORKERS=worker1:50051,worker2:50051
# WORKER_REPLICAS=2
# CUDA_VISIBLE_DEVICES=0,1

# ── Security & Authentication ───────────────────────────────────
# DISTLLM_API_KEY=your-api-key-here
# CLUSTER_KEY=your-cluster-key-here
# TLS_ENABLED=false

# [DANGER] Disable authentication (DEVELOPMENT ONLY — requires DISTLLM_DEBUG=1)
# DISTLLM_NO_AUTH=0

# DISTLLM_DEBUG=0
# DISTLLM_ADMIN_KEY=your-admin-key
# DISTLLM_TRUST_PROXY_HEADERS=0

# ── Redis / Cache ───────────────────────────────────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ── Observability ───────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=distllm
# PROMETHEUS_PORT=9090
# GRAFANA_PASSWORD=  # [REQUIRED] Set a strong password in production

# ── Logging ─────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# ── Network & Discovery ─────────────────────────────────────────
# DISTLLM_WAN_ENABLED=false
# DISTLLM_QUIC_PORT=4433

# ── Backend Selection ────────────────────────────────────────────
# DISTLLM_BACKEND=auto
# VLLM_GPU_MEMORY_UTILIZATION=0.9
# LLAMACPP_N_GPU_LAYERS=999

# ── Speculative Decoding ────────────────────────────────────────
# DISTLLM_DRAFT_MODEL=
# DISTLLM_REMOTE_DRAFT_API_ENDPOINT=
# DISTLLM_REMOTE_DRAFT_API_KEY=

# ── Rate Limiting & Quotas ──────────────────────────────────────
# DISTLLM_RATE_LIMIT_ENABLED=true
# DISTLLM_RATE_LIMIT_RPM=60
# QUOTA_ENABLED=false
# QUOTA_DEFAULT_TOKENS_PER_DAY=1000000

# ── Dashboard ───────────────────────────────────────────────────
# DISTLLM_DASHBOARD_HOST=127.0.0.1
# DISTLLM_DASHBOARD_PORT=8080

# ── Website / Plausible Analytics ────────────────────────────────
# PLAUSIBLE_DOMAIN=plausible.io
# PLAUSIBLE_DATA_DOMAIN=distllm.dev
# SENTRY_DSN=

# ── Advanced / Debug ────────────────────────────────────────────
# DISTLLM_ENABLE_DEBUG_ROUTES=false
# DISTLLM_DEFRAG_INTERVAL=300
# DISTLLM_MAX_BATCH_SIZE=64
# DISTLLM_GRPC_MAX_MESSAGE_SIZE=1073741824

# ── GPU / Hardware ───────────────────────────────────────────────
# DISTLLM_GPU_MEMORY_FRACTION=0.9
# DISTLLM_CPU_OFFLOAD=false

# ── Docker Compose (website) ────────────────────────────────────
# POSTGRES_PASSWORD=change-this-password  # [REQUIRED for production]
# SECRET_KEY_BASE=  # [REQUIRED] Generate with: openssl rand -base64 64
