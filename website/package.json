{
  "name": "distllm-website",
  "version": "0.4.0",
  "private": true,
  "description": "DistLLM — Distributed LLM Inference Website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "npx serve dist -l 3000",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/accessibility.spec.js",
    "test:security": "playwright test tests/security.spec.js",
    "test:visual": "playwright test tests/visual-regression.spec.js",
    "lint": "eslint js/**/*.js --fix",
    "format": "prettier --write 'js/**/*.js' 'css/**/*.css' 'tests/**/*.js' '*.html'",
    "check": "npm run lint && npm run test:unit && npm run test:e2e",
    "lighthouse": "lhci autorun",
    "clean": "rm -rf dist node_modules"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "eslint": "^9.0.0",
    "jsdom": "^24.0.0",
    "lighthouse": "^12.0.0",
    "prettier": "^3.3.0",
    "serve": "^14.2.0",
    "terser": "^5.31.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
