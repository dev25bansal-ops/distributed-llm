  "DistLLM RAG Bootstrap (JS)": {
    "prefix": "distllm-rag-js",
    "scope": "javascript,typescript",
    "body": [
      "import { DistLLM } from \"distllm\";",
      "",
      "// Bootstrap a Retrieval-Augmented Generation pipeline",
      "const client = new DistLLM({ baseUrl: \"${1:http://localhost:8000}\" });",
      "",
      "const docs = ${2:[\"Document one text...\", \"Document two text...\"]};",
      "const embeddings = await client.embeddings.create({ model: \"${3:text-embedding}\", input: docs });",
      "",
      "// Naive in-memory index (replace with a vector DB in production)",
      "const index = docs.map((text, i) => ({ text, vector: embeddings.data[i].embedding }));",
      "",
      "const query = \"${4:What does the doc say?}\";",
      "const qEmb = (await client.embeddings.create({ model: \"${3:text-embedding}\", input: [query] })).data[0].embedding;",
      "",
      "// Cosine similarity retrieval",
      "const cosine = (a, b) => a.reduce((s, v, i) => s + v * b[i], 0) / (Math.hypot(...a) * Math.hypot(...b));",
      "const ranked = [...index].sort((a, b) => cosine(qEmb, b.vector) - cosine(qEmb, a.vector));",
      "const context = ranked.slice(0, ${5:3}).map((d) => d.text).join(\"\\n\");",
      "",
      "const prompt = `Context:\\n${context}\\n\\nQuestion: ${query}`;",
      "const answer = await client.chat.completions.create({",
      "  model: \"${6:default}\",",
      "  messages: [{ role: \"user\", content: prompt }],",
      "});",
      "console.log(answer.choices[0].message.content);"
    ],
    "description": "DistLLM RAG bootstrap in JavaScript/TypeScript"
  }
}
