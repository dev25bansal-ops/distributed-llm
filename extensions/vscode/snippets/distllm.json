{
  "DistLLM Chat Completion (Python)": {
    "prefix": "distllm-chat-py",
    "scope": "python",
    "body": [
      "from distllm import DistLLM",
      "",
      "client = DistLLM(base_url=\"${1:http://localhost:8000}\")",
      "resp = client.chat.completions.create(",
      "    model=\"${2:default}\",",
      "    messages=[{\"role\": \"user\", \"content\": \"${3:Hello, DistLLM!}\"}],",
      "    max_tokens=${4:256},",
      "    temperature=${5:0.7},",
      ")",
      "print(resp.choices[0].message.content)"
    ],
    "description": "DistLLM OpenAI-compatible chat completion in Python"
  },
  "DistLLM Streaming Chat (Python)": {
    "prefix": "distllm-stream-py",
    "scope": "python",
    "body": [
      "from distllm import DistLLM",
      "",
      "client = DistLLM(base_url=\"${1:http://localhost:8000}\")",
      "stream = client.chat.completions.create(",
      "    model=\"${2:default}\",",
      "    messages=[{\"role\": \"user\", \"content\": \"${3:Tell me a story}\"}],",
      "    max_tokens=${4:256},",
      "    stream=True,",
      ")",
      "for chunk in stream:",
      "    delta = chunk.choices[0].delta.content or \"\"",
      "    print(delta, end=\"\", flush=True)"
    ],
    "description": "DistLLM streaming chat completion in Python"
  },
