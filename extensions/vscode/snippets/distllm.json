  "DistLLM RAG Bootstrap (Python)": {
    "prefix": "distllm-rag-py",
    "scope": "python",
    "body": [
      "from distllm import DistLLM",
      "",
      "# Bootstrap a Retrieval-Augmented Generation pipeline",
      "client = DistLLM(base_url=\"${1:http://localhost:8000}\")",
      "",
      "docs = ${2:[\"Document one text...\", \"Document two text...\"]}",
      "embeddings = client.embeddings.create(model=\"${3:text-embedding}\", input=docs)",
      "",
      "# Naive in-memory index (replace with a vector DB in production)",
      "index = list(zip(docs, [e.embedding for e in embeddings.data]))",
      "",
      "query = \"${4:What does the doc say?}\"",
      "q_emb = client.embeddings.create(model=\"${3:text-embedding}\", input=[query]).data[0].embedding",
      "",
      "# Cosine similarity retrieval",
      "import numpy as np",
      "",
      "",
      "def cosine(a, b):",
      "    return float(np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b)))",
      "",
      "",
      "ranked = sorted(index, key=lambda d: cosine(q_emb, d[1]), reverse=True)",
      "context = \"\\n\".join(d[0] for d in ranked[:${5:3}])",
      "",
      "prompt = f\"Context:\\n{context}\\n\\nQuestion: {query}\"",
      "answer = client.chat.completions.create(",
      "    model=\"${6:default}\",",
      "    messages=[{\"role\": \"user\", \"content\": prompt}],",
      ")",
      "print(answer.choices[0].message.content)"
    ],
    "description": "DistLLM RAG bootstrap in Python"
  },
  "DistLLM Chat Completion (JS)": {
    "prefix": "distllm-chat-js",
    "scope": "javascript,typescript",
    "body": [
      "import { DistLLM } from \"distllm\";",
      "",
      "const client = new DistLLM({ baseUrl: \"${1:http://localhost:8000}\" });",
      "const resp = await client.chat.completions.create({",
      "  model: \"${2:default}\",",
      "  messages: [{ role: \"user\", content: \"${3:Hello, DistLLM!}\" }],",
      "  max_tokens: ${4:256},",
      "  temperature: ${5:0.7},",
      "});",
      "console.log(resp.choices[0].message.content);"
    ],
    "description": "DistLLM OpenAI-compatible chat completion in JavaScript/TypeScript"
  },
  "DistLLM Streaming Chat (JS)": {
    "prefix": "distllm-stream-js",
    "scope": "javascript,typescript",
    "body": [
      "import { DistLLM } from \"distllm\";",
      "",
      "const client = new DistLLM({ baseUrl: \"${1:http://localhost:8000}\" });",
      "const stream = await client.chat.completions.create({",
      "  model: \"${2:default}\",",
      "  messages: [{ role: \"user\", content: \"${3:Tell me a story}\" }],",
      "  max_tokens: ${4:256},",
      "  stream: true,",
      "});",
      "for await (const chunk of stream) {",
