# ==========================================================================
# DistLLM .dockerignore — exclude build context bloat and secrets
# ==========================================================================

# Git
.git/
.gitignore
.gitattributes
.gitmodules
.github/

# Build artifacts
build/
dist/
*.egg-info/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Tests and benchmarks
tests/
benchmarks/
test-results/

# Docs
docs/
website/
*.md
*.rst

# Development
.devcontainer/
.vscode/
.idea/
*.swp
*.swo
*~
.envrc
.env
*.env
.tox/

# Tauri desktop app (Rust build artifacts)
tauri/target/
tauri/node_modules/
tauri/src-tauri/target/

# SDK build artifacts
sdk/go/
sdk/rust/
sdk/node_modules/
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Secrets and credentials
**/credentials.json
**/service-account.json
**/*.pem
**/*.key
**/id_rsa*
**/*.p12
**/*.cert

# OS files
.DS_Store
Thumbs.db
Desktop.ini
*.log
