# EditorConfig — https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ts,js,svelte,tsx,jsx}]
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{py,pyi}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{proto}]
indent_size = 2
