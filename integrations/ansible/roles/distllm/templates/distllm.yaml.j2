# DistLLM configuration — generated by Ansible
coordinator:
  host: {{ distllm_coordinator_host }}
  port: {{ distllm_coordinator_port }}

log_level: info

{% if distllm_redis_enabled %}
redis:
  address: "{{ distllm_redis_host }}:{{ distllm_redis_port }}"
{% endif %}

models:
  cache_dir: {{ distllm_model_cache_dir }}
  default_model: {{ distllm_default_model }}
